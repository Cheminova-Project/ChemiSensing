<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/ToolsMenu.uss?fileID=7433441132597879392&amp;guid=3eecc4c3a6779fc4bb294b838a95c21d&amp;type=3#ToolsMenu"/>
    <ui:VisualElement name="background" picking-mode="Ignore" style="flex-grow: 0; flex-shrink: 0; width: 100%; height: 100%; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgba(0, 0, 0, 0.25); border-right-color: rgba(0, 0, 0, 0.25); border-top-color: rgba(0, 0, 0, 0.25); border-bottom-color: rgba(0, 0, 0, 0.25); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; background-color: rgba(0, 0, 0, 0); overflow: visible; background-image: none;">
        <ui:VisualElement name="bottom-menu" style="flex-grow: 1; height: 15%; max-height: 15%; bottom: 0; top: auto; position: absolute; width: 100%; background-color: rgb(18, 171, 195); flex-shrink: 1; justify-content: space-around; flex-direction: row; left: 0; -unity-text-align: middle-center; white-space: nowrap; align-content: stretch; align-self: center; align-items: center; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgba(0, 0, 0, 0.45); border-right-color: rgba(0, 0, 0, 0.45); border-top-color: rgba(0, 0, 0, 0.45); border-bottom-color: rgba(0, 0, 0, 0.45); overflow: visible;"/>
        <ui:VisualElement name="tool-window" style="flex-grow: 1; width: 30%; height: 85%; max-height: 85%; min-height: 85%; max-width: 30%; min-width: 30%; flex-shrink: 1; flex-basis: auto; background-color: rgba(255, 255, 255, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgba(0, 0, 0, 0.45); border-right-color: rgba(0, 0, 0, 0.45); border-top-color: rgba(0, 0, 0, 0.45); border-bottom-color: rgba(0, 0, 0, 0.45); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; display: flex; position: absolute; left: 0; overflow: hidden;"/>
        <ui:VisualElement name="hidden-window" style="flex-grow: 1; width: 5%; height: 5%; max-height: 5%; min-height: 5%; max-width: 5%; min-width: 5%; flex-shrink: 1; flex-basis: auto; background-color: rgba(255, 255, 255, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgba(0, 0, 0, 0.45); border-right-color: rgba(0, 0, 0, 0.45); border-top-color: rgba(0, 0, 0, 0.45); border-bottom-color: rgba(0, 0, 0, 0.45); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; display: flex; position: absolute; left: 25%; overflow: hidden; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
        <ui:VisualElement name="aux-window" picking-mode="Ignore" style="flex-grow: 1; height: 85%; min-height: 85%; max-height: 85%; width: 30%; min-width: 30%; max-width: 30%; right: 0; position: absolute;"/>
        <ui:VisualElement name="message-box" style="flex-grow: 0; height: 10%; max-height: none; bottom: 15%; top: auto; position: absolute; width: 40%; background-color: rgb(189, 189, 189); flex-shrink: 1; justify-content: space-around; flex-direction: row; left: auto; -unity-text-align: middle-center; white-space: nowrap; align-content: stretch; align-self: center; align-items: center; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgba(0, 0, 0, 0.45); border-right-color: rgba(0, 0, 0, 0.45); border-top-color: rgba(0, 0, 0, 0.45); border-bottom-color: rgba(0, 0, 0, 0.45); overflow: visible; min-height: 25px;">
            <AutoSizeLabel name="message-label" min-font-size="20" max-font-size="50" text="" style="height: 90%; width: 90%; color: rgb(235, 87, 87); -unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Mulish/static/Mulish-Regular.ttf?fileID=12800000&amp;guid=722f676cd3b8d41469ff5fc9c286d6a3&amp;type=3#Mulish-Regular&quot;); flex-wrap: wrap; margin-left: 0; margin-right: 0; padding-right: 0; padding-left: 0; padding-top: 0; padding-bottom: 0; margin-bottom: 0; margin-top: 0; white-space: normal;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="loading-screen" enabled="true" style="flex-grow: 0; flex-shrink: 0; width: 100%; height: 100%; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgba(0, 0, 0, 0.25); border-right-color: rgba(0, 0, 0, 0.25); border-top-color: rgba(0, 0, 0, 0.25); border-bottom-color: rgba(0, 0, 0, 0.25); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; background-color: rgb(18, 171, 195); overflow: visible; background-image: none; position: absolute; visibility: visible; align-self: center; align-items: center; justify-content: center; display: none;">
        <AutoSizeLabel name="loading-text" text="The 3D model is being downloaded. &#10;Please wait..." min-font-size="10" style="width: 90%; height: 90%; -unity-text-align: middle-center; margin-left: 4px;"/>
    </ui:VisualElement>
</ui:UXML>
