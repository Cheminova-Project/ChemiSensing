<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="SegmentsContainer" style="flex-grow: 1; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
        <ui:VisualElement name="Header" style="flex-grow: 0; flex-direction: row;">
            <ui:Label text="START" name="START" style="width: 25%; -unity-text-align: middle-center;"/>
            <ui:Label text="END" name="END" style="width: 25%; -unity-text-align: middle-center;"/>
            <ui:Label text="LENGTH" name="LENGTH" style="width: 40%; -unity-text-align: middle-center;"/>
        </ui:VisualElement>
        <ui:VisualElement name="RulerSegment" style="flex-grow: 0; height: 50px; flex-direction: row; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px;">
            <ui:DropdownField name="segment-start" style="white-space: normal; text-overflow: clip; -unity-text-align: upper-left; width: 25%;"/>
            <ui:DropdownField name="segment-end" style="width: 25%;"/>
            <ui:Label text="Label" name="segment-length" style="width: 40%; -unity-text-align: middle-center;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
