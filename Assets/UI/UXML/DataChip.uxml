<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/chip.uss?fileID=7433441132597879392&amp;guid=c1d1e49d767d1d949bf5470fa3ceff13&amp;type=3#chip"/>
    <ui:VisualElement name="DocumentChip" class="chip" style="flex-direction: row; align-items: center; width: 100%; min-height: 80px; margin: 5px 0; padding: 10px; background-color: rgb(249, 223, 170); overflow: hidden;">
        <ui:VisualElement name="DocumentLogo" style="width: 80px; height: 80px; flex-shrink: 0; background-image: url(&quot;project://database/Assets/Images/addphoto.png?fileID=21300000&amp;guid=075cc8bdc87e3504aa6f97bbf4760262&amp;type=3#addphoto&quot;); -unity-background-scale-mode: scale-to-fit;"/>
        <ui:Label text="Label" name="DocumentText" style="flex-grow: 1; flex-shrink: 1; min-width: 0; margin-left: 15px; margin-right: 15px; font-size: 40px; -unity-text-align: middle-left; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;"/>
        <ui:Button name="DocumentButton" style="width: 80px; height: 80px; flex-shrink: 0; background-image: url(&quot;project://database/Assets/Images/Icons/delete.png?fileID=21300000&amp;guid=c14ceb17f8f5e5a43bf255afdf677f7c&amp;type=3#delete&quot;); border-width: 0; background-color: rgba(255, 255, 255, 0); -unity-background-scale-mode: scale-to-fit; cursor: link; -unity-background-image-tint-color: rgb(0, 0, 0);"/>
    </ui:VisualElement>
</ui:UXML>
