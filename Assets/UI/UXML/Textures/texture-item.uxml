<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/texture-item.uss?fileID=7433441132597879392&amp;guid=bbbbdb02028860a49ac7de454b42b954&amp;type=3#texture-item"/>
    <Style src="project://database/Assets/UI/USS/utils.uss?fileID=7433441132597879392&amp;guid=03b52ca0672e26748b8fdddb1dcce61b&amp;type=3#utils"/>
    <ui:VisualElement name="texture-item" class="texture-item" style="flex-grow: 1; height: 100px; min-height: 50px; flex-shrink: 0; flex-direction: row; width: 90%; justify-content: center; align-self: center; align-content: stretch; bottom: auto; top: 0; max-height: 100px; min-width: auto; max-width: none; white-space: nowrap; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px;">
        <AutoSizeLabel name="texture-name" text="Label" min-font-size="20" max-font-size="40" group="texture-items" style="white-space: normal; flex-grow: 1; width: 50%; max-width: none; -unity-text-align: middle-center;"/>
        <ui:Button name="texture-download-button" class="rounded-button" style="right: 0; flex-grow: 0; width: 100px; min-width: 100px; max-width: 100px; background-image: none; -unity-background-scale-mode: scale-to-fit; background-color: rgb(242, 189, 102); flex-shrink: 0;"/>
        <ui:Button name="texture-view-button" class="rounded-button" style="right: 0; flex-grow: 0; width: 100px; min-width: 100px; max-width: 100px; -unity-background-scale-mode: scale-to-fit; background-color: rgb(242, 189, 102);"/>
    </ui:VisualElement>
</ui:UXML>
