            <ui:VisualElement name="record-details-container" style="display: none; background-color: rgb(255, 255, 255); border-radius: 12px; border-width: 2px; border-color: rgb(226, 232, 240); overflow: hidden; width: 100%; margin-bottom: 40px;">
