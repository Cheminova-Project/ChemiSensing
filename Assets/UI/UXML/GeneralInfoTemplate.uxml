                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; padding: 20px; border-bottom-width: 1px; border-color: rgb(220, 220, 220); background-color: rgb(245, 245, 245);">
                            <ui:Label text="Creator" style="flex-basis: 50%; flex-shrink: 1; font-size: 40px; color: rgb(50, 50, 50); white-space: normal; padding-right: 15px;"/>
                            <ui:Label name="creator-value" text="Unknown" style="flex-basis: 50%; flex-shrink: 1; font-size: 40px; color: rgb(50, 50, 50); white-space: normal;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; padding: 20px; border-bottom-width: 1px; border-color: rgb(220, 220, 220); background-color: rgb(224, 224, 224);">
