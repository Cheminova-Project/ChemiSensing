                </ui:VisualElement>
                <ui:VisualElement style="padding: 30px;">
                    <ui:Label name="record-subtitle" text="" style="font-size: 40px; color: rgb(71, 85, 105); margin-bottom: 40px; white-space: normal; flex-shrink: 1;"/>
                    <ui:VisualElement style="flex-grow: 1; background-color: rgb(255, 255, 255); border-radius: 8px; border-width: 2px; border-color: rgb(0, 0, 0); width: 100%;">
                        <ui:VisualElement style="flex-direction: row; padding: 25px 20px; border-bottom-width: 2px; border-color: rgb(0, 0, 0); background-color: rgb(224, 224, 224);">
                            <ui:Label text="Property" style="flex-basis: 50%; font-size: 45px; -unity-font-style: bold; color: rgb(30, 30, 30); white-space: normal; padding-right: 15px;"/>
                            <ui:Label text="Value" style="flex-basis: 50%; font-size: 45px; -unity-font-style: bold; color: rgb(30, 30, 30); white-space: normal;"/>
