<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/utils.uss?fileID=7433441132597879392&amp;guid=03b52ca0672e26748b8fdddb1dcce61b&amp;type=3#utils"/>
    <Style src="project://database/Assets/UI/USS/users.uss?fileID=7433441132597879392&amp;guid=b9801538630058d4ebfeaddf09094586&amp;type=3#users"/>
    <ui:VisualElement name="Background" style="flex-grow: 1; background-color: rgb(255, 249, 249); width: 100%; height: 100%; flex-shrink: 0; min-width: 100%; max-width: 100%; max-height: 100%; min-height: 100%;">
        <ui:VisualElement name="Header" style="flex-grow: 0; height: 10%; background-color: rgba(18, 171, 195, 0.87); min-height: 80px; color: rgb(18, 171, 195);">
            <ui:Label text="User audio" name="header-text" style="height: 100%; color: rgb(0, 0, 0); -unity-text-align: middle-center; font-size: 50px;"/>
        </ui:VisualElement>
        <ui:ScrollView name="users-container" 
                       mode="Vertical" 
                       touch-scroll-behavior="Clamped" 
                       horizontal-scroller-visibility="Hidden" 
                       vertical-scroller-visibility="Auto"
                       mouse-wheel-scroll-size="40"
                       style="flex-grow: 1; width: 100%;">
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>