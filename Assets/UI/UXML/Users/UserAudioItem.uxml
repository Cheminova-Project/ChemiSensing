<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/utils.uss?fileID=7433441132597879392&amp;guid=03b52ca0672e26748b8fdddb1dcce61b&amp;type=3#utils"/>
    <Style src="project://database/Assets/UI/USS/slider.uss?fileID=7433441132597879392&amp;guid=612d3facf2d25ca4c829fcdb1656919f&amp;type=3#slider"/>
    <ui:VisualElement name="RulerSegment" style="flex-grow: 0; height: 150px; flex-direction: row; margin-left: 10px; margin-right: 10px; justify-content: center; align-content: center; margin-top: 10px; margin-bottom: 10px; border-bottom-width: 2px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);">
        <ui:VisualElement name="left-side" style="flex-grow: 1; width: 75%;">
            <ui:VisualElement name="top-bar" style="flex-grow: 1; height: 50%; font-size: 45px; white-space: nowrap; -unity-text-align: middle-center;">
                <ui:Label text="Label" name="username" style="-unity-text-align: middle-left; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; margin-top: 2px; margin-left: 4px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="bottom-bar" style="flex-grow: 0; width: auto; flex-direction: row; margin-left: 0%; height: 50%;">
                <ui:Slider label="Volume" value="1" high-value="1" name="volume-slider" fill="true" show-input-field="false" inverted="false" focusable="true" style="min-height: auto; width: 100%; -unity-text-align: middle-left; font-size: 35px; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="right-side" style="flex-grow: 1; width: 25%;">
            <ui:Button name="mute-button" class="rounded-button" style="flex-grow: 1; padding-left: 10px; padding-right: 10px; padding-bottom: 10px; padding-top: 10px; margin-top: 10px; margin-right: 15px; margin-bottom: 10px; margin-left: 15px;">
                <ui:VisualElement name="mute-image" enabled="true" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Images/Icons/mic.png?fileID=2800000&amp;guid=f353dd065d8bd3142a70ba2fd8ef0432&amp;type=3#mic&quot;); -unity-background-scale-mode: scale-to-fit;"/>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
