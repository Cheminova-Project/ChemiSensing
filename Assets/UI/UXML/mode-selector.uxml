<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/rooms.uss?fileID=7433441132597879392&amp;guid=3206ad872bc42f34e89b8646dfc3ac4a&amp;type=3#rooms"/>
    <Style src="project://database/Assets/UI/USS/utils.uss?fileID=7433441132597879392&amp;guid=03b52ca0672e26748b8fdddb1dcce61b&amp;type=3#utils"/>
    <ui:VisualElement name="background" style="flex-grow: 1; background-color: rgb(255, 255, 255); width: 100%; height: 100%; min-width: 100%; min-height: 100%;">
        <ui:VisualElement name="top-bar" style="flex-grow: 0; height: 75px; flex-direction: row; background-color: rgb(18, 171, 195); min-height: 10%;">
            <AutoSizeLabel text="Mode selection" group="titles" style="-unity-text-align: middle-center; flex-grow: 1; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Mulish/static/Mulish-Regular.ttf?fileID=12800000&amp;guid=722f676cd3b8d41469ff5fc9c286d6a3&amp;type=3#Mulish-Regular&quot;); height: auto; -unity-font-style: bold; font-size: 50px;"/>
            <ui:Button icon-image="project://database/Assets/Images/Icons/exit.png?fileID=2800000&amp;guid=7e353c6b91ae6f54aa44d5c549fa9e37&amp;type=3#exit" name="exit-button" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(188, 188, 188, 0); padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; width: 10%;"/>
        </ui:VisualElement>
        <ui:VisualElement name="buttons-container" style="flex-grow: 1;">
            <ui:Button name="create-room" class="rounded-button" style="height: auto; min-height: auto; align-items: center; justify-content: center; align-self: stretch; align-content: center; flex-grow: 1; margin-left: 20%; margin-right: 20%; padding-top: 10px; padding-bottom: 10px; margin-top: 5%; margin-bottom: 5%;">
                <AutoSizeLabel text="Create room" group="room-buttons" style="position: absolute; width: 100%; height: 70%; top: auto; left: auto; bottom: auto; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Mulish/static/Mulish-Bold.ttf?fileID=12800000&amp;guid=fd0307a780a3b2347bcc299540a23ab8&amp;type=3#Mulish-Bold&quot;);"/>
            </ui:Button>
            <ui:Button name="join-room" class="rounded-button" style="min-height: auto; align-self: stretch; justify-content: center; align-content: center; align-items: center; flex-grow: 1; margin-left: 20%; margin-right: 20%; margin-top: 5%; margin-bottom: 5%; padding-bottom: 10px; padding-top: 10px;">
                <AutoSizeLabel text="Find rooms" group="room-buttons" style="position: absolute; width: 100%; height: 70%; top: auto; left: auto; align-content: center; align-items: center; bottom: auto; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Mulish/static/Mulish-Bold.ttf?fileID=12800000&amp;guid=fd0307a780a3b2347bcc299540a23ab8&amp;type=3#Mulish-Bold&quot;);"/>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
