.chip {
    flex-grow: 0;
    flex-shrink: 0;
    width: auto;
    padding: 4px 10px;
    margin: 4px;
    border-radius: 16px;
    background-color: rgb(224, 224, 224);
    flex-direction: row;
    align-items: center;
}

.chip:hover {
    background-color: rgb(213, 213, 213);
}

.chip:active {
    background-color: rgb(192, 192, 192);
}

.chip Label {
    font-size: 13px;
    color: rgb(51, 51, 51);
    margin-left: 4px;
    text-overflow: ellipsis;
}

.chip Image {
    width: 16px;
    height: 16px;
    margin-right: 4px;
}
