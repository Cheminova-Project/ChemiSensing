<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/utils.uss?fileID=7433441132597879392&amp;guid=03b52ca0672e26748b8fdddb1dcce61b&amp;type=3#utils"/>
    <ui:VisualElement name="RulerSegment" style="flex-grow: 0; height: 150px; flex-direction: row; margin-left: 10px; margin-right: 10px; justify-content: center; align-content: center; margin-top: 10px; margin-bottom: 10px; font-size: 40px; border-bottom-width: 2px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);">
        <ui:Label text="Label" name="username" style="font-size: 40px; width: 60%; -unity-text-align: middle-left; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;"/>
        <ui:VisualElement name="options" style="flex-grow: 0; width: 40%; flex-direction: row; margin-left: 0%; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px;">
            <ui:Button name="join-button" class="rounded-button" style="flex-grow: 1; padding-left: 1px; padding-right: -2px; padding-bottom: 1px; padding-top: 1px;">
                <ui:VisualElement name="join-image" enabled="true" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Images/Icons/teleport.png?fileID=2800000&amp;guid=06030aa7b9662a246805f0415b935c07&amp;type=3#teleport&quot;); -unity-background-scale-mode: scale-to-fit;"/>
            </ui:Button>
            <ui:Button name="attract-button" class="rounded-button" style="flex-grow: 1; padding-left: 1px; padding-top: 1px; padding-bottom: 1px; padding-right: 1px;">
                <ui:VisualElement name="attract-image" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Images/Icons/call.png?fileID=2800000&amp;guid=26c90fbc9098c384da33939de29280ca&amp;type=3#call&quot;); -unity-background-scale-mode: scale-to-fit;"/>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
