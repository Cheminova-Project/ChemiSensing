using System;
using System.Collections;
using System.Net.Sockets;
using System.Text;
using UnityEngine;
using UnityEngine.SceneManagement;
using Unity.Netcode;

public class ExitRoom : ToolComponent
{
    protected override void OnToolActivatedInternal()
    {
        base.OnToolActivatedInternal();
        // 2. Destruir TODOS los objetos de DontDestroyOnLoad
        Debug.Log("[ExitRoom] Iniciando secuencia de salida segura...");

        // 1. Creamos un objeto "balsa" temporal en la escena.
        // Al ser un GameObject nuevo y vacío, NO es un NetworkObject, 
        // por lo que Netcode NO lo destruirá al hacer Shutdown.
        GameObject lifeRaft = new GameObject("SceneCleaner_LifeRaft");
        
        // 2. Le añadimos un componente runner para que ejecute la corutina
        var runner = lifeRaft.AddComponent<SceneCleanerRunner>();
        runner.StartExitRoutine();
    }
}

/// <summary>
/// Pequeño componente auxiliar que sobrevive al Shutdown de Netcode
/// para poder cargar la siguiente escena.
/// </summary>
public class SceneCleanerRunner : MonoBehaviour
{
    public void StartExitRoutine()
    {
        StartCoroutine(ExitProcess());
    }

    private IEnumerator ExitProcess()
    {
        if (GlobalVariables.Instance != null)
        {
            GlobalVariables.Instance.SetSelectedE3DModelData(null);
        }

        if (NetworkManager.Singleton != null)
        {
            GameObject temp = new GameObject("TempDDOLDetector");
            DontDestroyOnLoad(temp);
            Scene ddolScene = temp.scene;
            DestroyImmediate(temp);
            
            Debug.Log("[SceneCleaner] Iniciando proceso de salida...");
            NetworkAudio.LocalGLTFLoaded = false; 

            // 1. Enviamos el mensaje TCP al Python y damos la orden de apagar Netcode
            if (RoomsManager.Instance != null)
            {
                RoomsManager.Instance.LeaveRoom();
            }
            else
            {
                if (RoomState.CurrentRoomPort != -1)
                {
                    string uname = GlobalManagement.Instance != null ? GlobalManagement.Instance.username : "Unknown";
                    string serverIP = NetworkServerConfiguration.Instance.getMatchmakingServerIP();
                    string safeToken = GlobalManagement.Instance != null ? GlobalManagement.Instance.token : "";
                    
                    // Creamos el JSON a mano de forma segura
                    string jsonSalida = $"{{\"comando\":\"SALIR_SALA\",\"puerto\":{RoomState.CurrentRoomPort},\"usuario\":\"{uname}\",\"bearerToken\":\"{safeToken}\"}}";
                    
                    try
                    {
                        using (TcpClient cliente = new TcpClient(serverIP, 7777))
                        using (NetworkStream stream = cliente.GetStream())
                        {
                            byte[] data = Encoding.UTF8.GetBytes(jsonSalida);
                            stream.Write(data, 0, data.Length);
                            Debug.Log($"[SceneCleaner] Mensaje SALIR_SALA enviado de emergencia a Python (Puerto: {RoomState.CurrentRoomPort})");
                        }
                    }
                    catch (Exception ex)
                    {
                        Debug.LogError($"[SceneCleaner] Error enviando SALIR_SALA de emergencia: {ex.Message}");
                    }
                    
                    RoomState.CurrentRoomPort = -1; // Limpiamos el estado
                }

                NetworkManager.Singleton.Shutdown();
            }

            // 2. ENFOQUE POR EVENTOS: Esperamos hasta que Netcode termine completamente su apagado
            yield return new WaitWhile(() => NetworkManager.Singleton != null && NetworkManager.Singleton.ShutdownInProgress);
            Debug.Log("[SceneCleaner] Netcode apagado limpiamente.");

            // 3. Limpieza de escena respetando al RoomsManager para no perder la conexión
            if (NetworkManager.Singleton != null)
            {
                Destroy(NetworkManager.Singleton.gameObject);
            }
            
            foreach (GameObject go in ddolScene.GetRootGameObjects())
            {
                if (go.name == "Token")
                    continue;

                DestroyImmediate(go);
            }
        
            if (UIDocumentManager.Instance != null)
                DestroyImmediate(UIDocumentManager.Instance.gameObject);
        }

        SceneManager.LoadScene("MainScene");
    }
}