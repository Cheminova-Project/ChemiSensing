<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/rooms.uss?fileID=7433441132597879392&amp;guid=3206ad872bc42f34e89b8646dfc3ac4a&amp;type=3#rooms"/>
    <ui:VisualElement name="background" style="flex-shrink: 0; height: 100px; flex-direction: row; align-content: stretch; align-self: stretch; width: 100%;">
        <ui:VisualElement name="room-image" style="flex-grow: 1; background-image: resource(&quot;UI/Icons/documentation/image&quot;); -unity-background-scale-mode: scale-to-fit; margin-left: 10px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; width: 100px;"/>
        <AutoSizeLabel name="room-name" text="Texto" style="flex-grow: 2; -unity-text-align: middle-center; align-self: stretch; align-content: center; justify-content: center; align-items: center;"/>
        <ui:VisualElement name="users-count-container" style="flex-grow: 0.5; flex-direction: row; align-items: center; justify-content: center; margin-top: 15px; margin-bottom: 15px; margin-right: 15px; background-color: rgba(0, 0, 0, 0.05); border-radius: 15px; padding-left: 15px; padding-right: 15px; width: 300px;">
            <ui:VisualElement name="user-icon" style="width: 100px; height: 100px; background-image: url(&quot;project://database/Assets/Images/Icons/Users.png?fileID=21300000&amp;guid=0952e8fa82272734d97d6c30c5e5056b&amp;type=3#Users&quot;); -unity-background-scale-mode: scale-to-fit; margin-right: 10px; -unity-background-image-tint-color: rgb(80, 80, 80);"/>
            <AutoSizeLabel name="room-users-count" text="0 / 5" style="-unity-text-align: middle-center; align-self: center; -unity-font-style: bold; color: rgb(80, 80, 80); flex-grow: 1; width: 200px;"/>
        </ui:VisualElement>
        <ui:Button name="room-button" class="rounded-button" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/VRTemplateAssets/Sprites/Icons/Scroll%20Right.png?fileID=2800000&amp;guid=639b00403a9c1cf4884b495c00168283&amp;type=3#Scroll Right&quot;); background-position-y: center; height: auto; width: 100px; margin-top: 15px; margin-bottom: 15px; -unity-background-scale-mode: scale-to-fit;"/>
    </ui:VisualElement>
</ui:UXML>
