<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="CameraTouchArea" style="background-color: rgba(0, 0, 0, 0.17); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-left-color: rgba(0, 0, 0, 0.38); border-right-color: rgba(0, 0, 0, 0.38); border-top-color: rgba(0, 0, 0, 0.38); border-bottom-color: rgba(0, 0, 0, 0.38); width: 100%; height: 100%;">
        <ui:VisualElement name="CameraOuterBorder">
            <ui:VisualElement name="CameraKnob"/>
        </ui:VisualElement>
        <ui:Label text="Camera Zone" style="-unity-text-align: middle-center; -unity-font-style: bold; font-size: 40px; padding-top: 30px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;"/>
    </ui:VisualElement>
</ui:UXML>
