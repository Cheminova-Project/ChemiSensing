using UnityEngine;

public class AudioManager : MonoBehaviour
{
    public static AudioManager Instance { get; private set; }
    public bool IsMuted { get; private set; } = false;

    private void Awake()
    {
        if (!GlobalVariables.Instance.GetIsAudioRoom())
            enabled = false;
            
        if (Instance != null && Instance != this) 
        {
            Destroy(this);
            return;
        }
        Instance = this;
    }

    /// <summary>
    /// Establece el estado de silencio a un valor EXACTO.
    /// </summary>
    /// <param name="shouldMute">El valor que viene del Toggle (true/false)</param>
    public void SetMuteState(bool shouldMute)
    {
        if (IsMuted != shouldMute)
        {
            IsMuted = shouldMute;
            Debug.Log($"[AudioManager] Estado actualizado: {(IsMuted ? "MUTEADO" : "SONIDO")}");
        }
    }
}