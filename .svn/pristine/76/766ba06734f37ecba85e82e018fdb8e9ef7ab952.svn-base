.unity-base-slider--horizontal .unity-base-slider__dragger{
    width: 30px;
    height: 30px;
    border-radius: 20px;
    background-color: #ffffff;
}

.unity-base-slider--horizontal .unity-base-slider__tracker{
    height: 10px;
    border-radius: 5px;
    background-color: #b3b3b3;
}

.unity-base-slider--horizontal .unity-base-slider__fill{
    height: 10px;
    border-radius: 5px;
    background-color: #f2bd66;
}