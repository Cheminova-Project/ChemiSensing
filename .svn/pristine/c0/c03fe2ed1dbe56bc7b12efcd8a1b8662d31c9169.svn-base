using System.Collections;
using Unity.Netcode;
using UnityEngine;
using UnityEngine.UIElements; 

public class GlobalCall : ToolComponent
{
    // Si usas el sistema dinámico con ToolDefinition, recuerda usar 'toolId' en vez de esto
    private string buttonName = "call_users"; 
    private Toggle myToggle; 
    private bool isProcessing = false; 

    protected override void OnToolActivatedInternal()
    {
        base.OnToolActivatedInternal();

        if (uIDocument != null)
        {
            // 1. Buscamos el Toggle
            myToggle = uIDocument.rootVisualElement.Q<Toggle>(buttonName); // O usa 'toolId'

            if (myToggle != null)
            {
                // PASO 1: Limpieza preventiva (por si acaso se llamó dos veces)
                myToggle.UnregisterValueChangedCallback(OnToggleValueChanged);

                // PASO 2: Configuración del botón
                // 'focusable = false' es CRUCIAL. Evita que el primer click solo sirva para "seleccionar" el botón.
                // Hace que reaccione al instante.
                myToggle.focusable = false;

                // PASO 4: Registrar el evento
                myToggle.RegisterValueChangedCallback(OnToggleValueChanged);
                
                // --- LA SOLUCIÓN ESTÁ AQUÍ ---
                // 3. Verificamos el estado PRESENTE.
                // Si el botón YA está encendido (porque lo pulsaste para abrir la herramienta),
                // lanzamos la lógica manualmente sin esperar al evento.
                if (myToggle.value == true && !isProcessing)
                {
                    StartCoroutine(ExecuteInvitationProcess());
                }
            }
            else
            {
                Debug.LogWarning($"[GlobalCall] No se encontró el Toggle: {buttonName}");
            }
        }
    }

    protected override void OnToolDeactivatedInternal()
    {
        base.OnToolDeactivatedInternal();
        
        if (myToggle != null)
        {
            myToggle.UnregisterValueChangedCallback(OnToggleValueChanged);
            myToggle = null;
        }
    }

    private void OnToggleValueChanged(ChangeEvent<bool> evt)
    {
        // Solo actuamos si es True y no estamos ocupados
        if (evt.newValue == true && !isProcessing)
        {
            StartCoroutine(ExecuteInvitationProcess());
        }
    }

    private IEnumerator ExecuteInvitationProcess()
    {
        isProcessing = true;
        
        // Desactivar interacción temporalmente
        if (myToggle != null) myToggle.SetEnabled(false);

        // --- LÓGICA DE RED ---
        var localPlayerObj = NetworkManager.Singleton.SpawnManager.GetLocalPlayerObject();
        if (localPlayerObj != null)
        {
            var localController = localPlayerObj.GetComponent<UserControllerPlayer>();
            if (localController != null)
            {
                localController.SendGlobalTeleportInvitation();
                Debug.Log("[UserMeeting] Invitación global enviada.");
            }
        }

        yield return new WaitForSeconds(0.5f); 

        // --- RESET / EFECTO REBOTE ---
        if (myToggle != null)
        {
            myToggle.SetEnabled(true);
            
            // Apagamos el toggle (sin notificar para no disparar el evento de nuevo)
            // Esto lo deja listo para la próxima vez.
            myToggle.SetValueWithoutNotify(false);
        }
        
        isProcessing = false;
        
        // Opcional: Si quieres que la "Herramienta" se cierre sola después de la acción:
        // gameObject.SetActive(false); 
        Destroy(gameObject);
    }
}