using StarterAssets;
using Unity.VisualScripting;
using UnityEngine;
using UnityEngine.InputSystem;

/// <summary>
/// Permite realizar raycasts desde la cámara en plataformas de escritorio.
/// Utilizado para interacción con objetos mediante el mouse.
/// </summary>
public class DesktopRaycaster : ScreenRaycaster
{
    [Header("Desktop Raycaster Settings")]
    [SerializeField] private DesktopInputActionReferences desktopInputActionReferences;
    [SerializeField] private BasicFirstPersonController firstPersonController;
    
    private void Start()
    {
        SetCameraMovementAllowed(false);
    }
    
    protected override void InitListeners()
    {
        base.InitListeners();
        desktopInputActionReferences.RightClick.action.performed += OnRightClickPressed;
        desktopInputActionReferences.RightClick.action.canceled += OnRightClickReleased;
    }

    protected override void DestroyListeners()
    {
        base.DestroyListeners();
        desktopInputActionReferences.RightClick.action.performed -= OnRightClickPressed;
        desktopInputActionReferences.RightClick.action.canceled -= OnRightClickReleased;
    }

    private void OnRightClickPressed(InputAction.CallbackContext context)
    {
        var phase = context.phase;
        if (phase != InputActionPhase.Performed && phase != InputActionPhase.Started)
            return;
        SetCameraMovementAllowed(true);
    }
    
    private void OnRightClickReleased(InputAction.CallbackContext context)
    {
        SetCameraMovementAllowed(false);
    }


    private void SetCameraMovementAllowed(bool allowed)
    {
        isMovingCamera = allowed;
        
        if (isMovingCamera)
        {
            // En desktop, mostramos un cursor o desactivamos controles FPS
            Cursor.lockState = CursorLockMode.Locked;
            firstPersonController.EnableCameraMovement(true);
        }
        else
        {
            // Al dejar de mover el puntero: liberamos cursor y reactivamos input
            Cursor.lockState = CursorLockMode.None;
            Cursor.visible = true;
            firstPersonController.EnableCameraMovement(false);
        }
    }

    /// <summary>
    /// Cámara desde la que se lanzan los raycasts.
    /// </summary>
    public Camera raycastCamera;

    /// <summary>
    /// Realiza un raycast desde la posición del mouse y devuelve el objeto impactado.
    /// </summary>
    /// <returns>Objeto impactado o null.</returns>
    public GameObject RaycastFromMouse()
    {
        Ray ray = raycastCamera.ScreenPointToRay(Input.mousePosition);
        if (Physics.Raycast(ray, out RaycastHit hit))
        {
            return hit.collider.gameObject;
        }
        return null;
    }
}