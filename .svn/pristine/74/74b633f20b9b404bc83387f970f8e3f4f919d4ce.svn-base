<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/CheminovaUI/Resources/UI/USS/login/login.uss?fileID=7433441132597879392&amp;guid=12ddf879e95fb5f46b6939efb2349dc2&amp;type=3#login"/>
    <engine:VisualElement name="Background" style="flex-grow: 1; width: 100%; height: 100%; flex-shrink: 1; flex-wrap: wrap; flex-direction: column; justify-content: space-between;">
        <engine:VisualElement name="header" class="header" style="flex-direction: row; align-items: auto; justify-content: space-between; align-self: flex-end; top: 0; left: auto; flex-shrink: 1; flex-grow: 1; height: 15%; padding-top: 28px; padding-right: 28px; padding-bottom: 28px; padding-left: 28px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;">
            <engine:VisualElement name="container-logo" class="left-section" style="flex-direction: row; margin-left: 10px; align-self: center; align-items: center; align-content: flex-start; height: 100%; width: auto;">
                <engine:Image name="image-logo" class="logo" style="height: 100%; width: 200px; background-image: resource(&quot;UI/Icons/logo/05_ANAGRAMA_Cheminova_NegroColor&quot;);"/>
                <engine:Label text="ChemiSensing" name="label-logo" class="register-text" style="font-size: 50px; -unity-font-style: bold;"/>
            </engine:VisualElement>
            <engine:VisualElement name="container-register" class="right-section" style="flex-direction: row; align-content: flex-end; align-items: center; justify-content: space-between; align-self: auto; padding-left: 0; right: 0; height: 100%; padding-top: 0; padding-right: 0; padding-bottom: 0; display: none;">
                <engine:Label text="Don’t have an account? " name="label-register" class="register-text" style="margin-right: 0; height: 50px; width: 400px; font-size: 30px; text-overflow: clip; -unity-text-align: middle-right; align-items: auto;"/>
                <engine:Button text="Register now" name="button-register" class="primary-link" style="padding-left: -6px; border-top-color: rgba(149, 149, 149, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); color: rgb(0, 0, 0); background-color: rgba(188, 188, 188, 0); font-size: 30px; -unity-font-style: bold; border-bottom-width: 0.9px; border-top-width: 5px; padding-top: 9px; -unity-text-align: middle-left; height: 50px; justify-content: center; align-items: auto; width: 220px;"/>
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:VisualElement name="LoginClassic" enabled="true" class="container container_login" style="border-top-width: 1px; font-size: 19px; border-bottom-width: 0; justify-content: center; padding-top: 60px; margin-left: 0; top: 15%; flex-grow: 1; flex-shrink: 1; height: 100%; max-height: 70%; align-content: center; flex-direction: column; bottom: 15%; padding-bottom: 60px; align-self: center; flex-basis: auto; flex-wrap: nowrap; display: none;">
            <engine:Label text="Welcome back" name="label-welcome" enabled="true" class="bold" style="-unity-font-style: bold; font-size: 80px; justify-content: space-around; align-content: center;"/>
            <engine:Label text="Enter your details to sign in to your account" name="label-description" class="regular" style="font-size: 40px; margin-bottom: 4px;"/>
            <engine:VisualElement name="interactive-elements" enabled="true" style="align-items: stretch; justify-content: space-between; width: 100%; min-width: auto; max-width: 1500px; display: flex; visibility: visible;">
                <engine:Label text="Username" name="label-username" style="-unity-font-style: bold; font-size: 30px;"/>
                <engine:TextField name="username-field" style="width: auto; height: 86px; font-size: 30px; border-bottom-width: 2px; border-left-width: 2px; border-top-width: 2px; border-right-width: 2px; border-left-color: rgb(140, 140, 140); border-right-color: rgb(140, 140, 140); border-top-color: rgb(140, 140, 140); border-bottom-color: rgb(140, 140, 140); -unity-background-image-tint-color: rgba(255, 255, 255, 0); background-color: rgba(0, 0, 0, 0);"/>
                <engine:Label text="Password" name="label-password" style="-unity-font-style: bold; font-size: 30px;"/>
                <engine:TextField name="password-field" isPasswordField="true" password="true" style="height: 86px; margin-bottom: 5px; font-size: 30px; border-left-color: rgb(140, 140, 140); border-right-color: rgb(140, 140, 140); border-top-color: rgb(140, 140, 140); border-bottom-color: rgb(140, 140, 140); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px;"/>
                <engine:Label name="password-error" text="Incorrect password or email" style="color: red; font-size: 20px; margin-bottom: 19px;"/>
                <engine:Button text="Forgot password?" name="button-forgot-password" class="forgot-password" style="margin-bottom: 10px; color: rgb(0, 0, 0); background-color: rgba(188, 188, 188, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-left-color: rgba(149, 149, 149, 0); font-size: 25px; padding-left: -8px; display: flex; visibility: hidden;"/>
                <engine:Button text="Continue" name="continue-button" class="continue-button" style="width: auto; height: 109px; justify-content: space-between; align-content: flex-end;"/>
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:VisualElement name="LoginSSO" enabled="true" class="container container_login" style="border-top-width: 1px; font-size: 19px; border-bottom-width: 0; justify-content: space-evenly; padding-top: 60px; margin-left: 0; top: 15%; flex-grow: 1; flex-shrink: 1; height: 100%; max-height: 70%; align-content: center; flex-direction: column; bottom: 15%; padding-bottom: 60px; align-self: center; flex-basis: auto; flex-wrap: nowrap; display: none; align-items: center;">
            <engine:Label text="Welcome back" name="label-welcome" enabled="true" class="bold" style="-unity-font-style: bold; font-size: 80px; justify-content: flex-start; align-content: flex-start; -unity-text-align: upper-left; align-self: auto; align-items: stretch;"/>
            <engine:Label text="Click the button to log in to your account" name="label-description" class="regular" style="font-size: 40px; margin-bottom: 4px;"/>
            <engine:VisualElement name="interactive-elements" enabled="true" style="align-items: stretch; justify-content: space-between; width: 100%; min-width: auto; max-width: 1500px; display: flex; visibility: visible;">
                <engine:Button text="Log in to my account" name="LogInAuth-button" data-source-path="" class="continue-button" style="width: 800px; height: 65px; justify-content: space-between; align-content: flex-end; font-size: 30px; align-self: center;"/>
            </engine:VisualElement>
            <engine:Label text="Not logged in " name="label-status" class="regular" style="font-size: 40px; margin-bottom: 4px;"/>
            <engine:Label text="You will be redirected to your browser to authentify yourself" name="label-description" class="regular" style="font-size: 40px; margin-bottom: 4px;"/>
        </engine:VisualElement>
        <engine:VisualElement name="footer" class="footer" style="flex-grow: 1; height: 15%; justify-content: center; top: auto; bottom: 0;">
            <engine:Image name="UV_Logo" source="project://database/Assets/CheminovaUI/Resources/UI/Icons/institutions/escut_UV_2linies_xano.svg?fileID=7388822144124034973&amp;guid=2a9bcc4d104ab694da1454ca3c03a82d&amp;type=3#escut_UV_2linies_xano" style="height: 100%;"/>
            <engine:GroupBox style="flex-direction: row; height: 100%; width: 70%;">
                <engine:Image name="UEFunding" source="project://database/Assets/CheminovaUI/Resources/UI/Icons/institutions/EUFunded.svg?fileID=7388822144124034973&amp;guid=50d9e305b08df9042921689cab1fc3f2&amp;type=3#EUFunded" scale-mode="ScaleToFit" style="width: 35%;"/>
                <engine:Label text="“ChemiNova has received funding from the European Union’s Horizon Europe Framework Programme under the grant agreement 101132441. Funded by the European Union. Views and opinions expressed are however those of the author(s) only and do not necessarily reflect of the European Union or Horizon Europe Framework Programme. Neither the European Union nor the granting authority can be held responsible for them.”" name="FundingText" language-direction="LTR" style="-unity-text-align: middle-left; white-space: pre-wrap; width: 65%; height: 100%; font-size: 26px; padding-left: 20px;"/>
            </engine:GroupBox>
        </engine:VisualElement>
        <engine:VisualElement name="visitor-error-panel" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.85); justify-content: center; align-items: center; display: none;">
            <engine:VisualElement style="background-color: rgb(40, 40, 40); border-radius: 15px; padding: 50px; width: 600px; align-items: center; border-width: 2px; border-color: rgb(241, 136, 49);">
                <engine:Label text="Access Denied" style="-unity-font-style: bold; font-size: 45px; color: rgb(255, 255, 255); margin-bottom: 20px;"/>
                <engine:Label text="Your current account role (Visitor) does not have permission to access the application." style="font-size: 25px; color: rgb(200, 200, 200); white-space: normal; -unity-text-align: middle-center; margin-bottom: 40px;"/>
                <engine:Button text="Back to Login" name="btn-visitor-back" class="continue-button" style="width: 300px; height: 60px; font-size: 25px;"/>
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
