using TMPro;
using UnityEngine;
using UnityEngine.Events;
using UnityEngine.UIElements;

/// <summary>
/// Controlador de la interfaz de usuario para una sala individual.
/// Permite mostrar y modificar los detalles de una sala específica.
/// </summary>
public class RoomUIController : MonoBehaviour
{
    /// <summary>
    /// Referencia a los elementos UI de la sala.
    /// </summary>
    public object roomUIElements;

    public Image m_Image;
    public TextMeshProUGUI m_ArtifactName;
    public TextMeshProUGUI m_CreatorName;

    /// <summary>
    /// Inicializa la UI de la sala.
    /// </summary>
    void Start()
    {
        // ...existing code...
    }

    public void SetImage(Image image)
    {
        m_Image = image;
    }
    
    public void SetArtifactName(string name)
    {
        m_ArtifactName.text  = name;
    }
    
    public void SetCreatorName(string name)
    {
        m_CreatorName.text  = name;
    }
}
