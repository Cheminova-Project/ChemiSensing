using UnityEngine;
using UnityEngine.InputSystem;

[CreateAssetMenu(menuName = "Player Inputs/Pointer Input Action References")]
public class PointerInputActionReferences : ScriptableObject
{
    [Header("Pointer inputs")]
    public InputActionProperty m_pointerPress; 
    public InputActionProperty m_pointerPositon; 
    public InputActionProperty m_pointerDelta;
    
    public InputActionProperty PointerPress
    {
        get => m_pointerPress;
        set => m_pointerPress = value;
    }
  
    public InputActionProperty PointerPosition
    {
        get => m_pointerPositon;
        set => m_pointerPositon = value;
    }
    
    public InputActionProperty PointerDelta
    {
        get => m_pointerDelta;
        set => m_pointerDelta = value;
    }
    
}
