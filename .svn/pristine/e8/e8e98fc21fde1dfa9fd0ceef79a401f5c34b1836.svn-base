using System.Collections;
using System.Collections.Generic;
using UnityEngine;
using System.Net.Sockets;
using System.Text;
using Newtonsoft.Json;
using Unity.Netcode;
using System;
using Unity.Netcode.Transports.UTP;
using UnityEngine.Events;

/// <summary>
/// Gestiona el conjunto de salas disponibles en la aplicación.
/// Permite crear, eliminar y acceder a salas.
/// </summary>
// ==================== Clases de Mensaje ====================

public class Mensaje
{
    public string comando { get; set; }
    public string creador { get; set; }
    public string nombre_sala { get; set; }
    public int chelementID { get; set; }
    public string bearerToken { get; set; }
    public bool hasAudio { get; set; }
    public string usuario { get; set; }
    public List<string> usuarios_aceptados { get; set; }
    public int cantidad { get; set; }
    public int puerto {  get; set; }
}

/// <summary>
/// Respuesta genérica del servidor con status y mensaje
/// </summary>
public class RespuestaServidor
{
    public string status { get; set; }
    public string mensaje { get; set; }
    public int puerto { get; set; }
    public List<string> comandos_validos { get; set; }
}

/// <summary>
/// Información de una sala activa en el servidor
/// </summary>
public class Servicio
{
    public string creador { get; set; }
    public string nombre_sala { get; set; }
    public int chelementID { get; set; }
    public int puerto { get; set; }
    public bool hasAudio { get; set; }
    public List<string> usuarios_aceptados { get; set; }
    public int jugadores_actuales { get; set; }
}

/// <summary>
/// Gestor de salas para conectar con el servidor Python de ChemiSensing
/// Maneja la creación, actualización y conexión a salas
/// </summary>
public class RoomsManager : MonoBehaviour
{
    [Header("UI Controllers")]
    public RoomManagerUIDocController _roomManagerUIDocController; // New UI Toolkit Controller
    
    [Header("Configuración de conexión")]
    [SerializeField] private float tiempoTimeoutSocket = 30f;
    [SerializeField] private int tamanoBufferRespuesta = 4096;
    [SerializeField] private float delayActualizacionSalas = 0.5f;
    private string lastRoomsJson = "";
    private Coroutine _serverSyncCoroutine;
    
    private const int PUERTO_SERVIDOR_MANAGER = 7777;
    
    public static RoomsManager Instance { get; private set; }

    ConnectionManager connectionManager => ConnectionManager.Instance;
    private void Awake()
    {
        if (Instance != null && Instance != this)
        {
            Debug.Log("[RoomsManager] Instancia duplicada detectada, transfiriendo UI y destruyendo clon.");
            Instance._roomManagerUIDocController = this._roomManagerUIDocController;
            Destroy(this.gameObject);
            return;
        }

        Instance = this;
        transform.SetParent(null);
        DontDestroyOnLoad(this.gameObject);
        Debug.Log("[RoomsManager] Instancia única establecida y protegida.");
    }
    
    private void Start()
    {
        StartCoroutine(ServerSyncLoop());
        
        if (NetworkManager.Singleton != null)
        {
            NetworkManager.Singleton.OnServerStarted += SetupServerCallbacks;
            
            if (NetworkManager.Singleton.IsServer && NetworkManager.Singleton.IsListening) 
                SetupServerCallbacks();
            
            NetworkManager.Singleton.OnClientDisconnectCallback += OnClientLocalDisconnected;
        }
    }
    
    private void SetupServerCallbacks()
    {
        Debug.Log("[RoomsManager] Servidor Headless de Netcode iniciado correctamente.");
    }

    private IEnumerator ServerSyncLoop()
    {
        while (true)
        {
            yield return new WaitForSeconds(5f);
            
            if (NetworkManager.Singleton != null && NetworkManager.Singleton.IsServer && NetworkManager.Singleton.IsListening)
            {
                try
                {
                    ActualizarConteoJugadores();
                }
                catch (System.Exception ex)
                {
                    Debug.LogError($"[RoomsManager-BUG] Error crítico en el latido del servidor: {ex.Message}");
                }
            }
        }
    }
    
    private void ActualizarConteoJugadores()
    {
        if (NetworkManager.Singleton == null || !NetworkManager.Singleton.IsServer)
            return;
        
        Debug.Log("[RoomsManager] [VIGILANTE] Iniciando escaneo de jugadores...");
        try
        {
            ushort puertoServidor = 7777; // Valor por defecto por seguridad
            if (NetworkManager.Singleton.NetworkConfig.NetworkTransport is UnityTransport transport)
            {
                puertoServidor = transport.ConnectionData.Port;
            }

            int count = 0;
            List<string> usuariosActivos = new List<string>();

            if (NetworkManager.Singleton.ConnectedClientsIds != null)
            {
                // Clonamos para evitar el error si alguien se desconecta justo ahora
                List<ulong> idsCopiados = new List<ulong>(NetworkManager.Singleton.ConnectedClientsIds);
                count = idsCopiados.Count;

                foreach (ulong id in idsCopiados)
                {
                    if (LocalRegistry.Instance != null)
                    {
                        var info = LocalRegistry.Instance.GetClientInfo(id);
                        if (!string.IsNullOrEmpty(info.Username))
                        {
                            usuariosActivos.Add(info.Username);
                        }
                    }
                }
            }

            Debug.Log($"[RoomsManager] [VIGILANTE] Conectados reales: {count}. Sincronizando con Python...");
            EnviarMensaje("ACTUALIZAR_JUGADORES", puerto: puertoServidor, cantidad: count, usuarios_aceptados: usuariosActivos);
        }
        catch (Exception ex)
        {
            Debug.LogError($"[RoomsManager-ERROR] Error al recopilar usuarios en el servidor: {ex.Message}");
        }
    }
    
    private void OnClientLocalDisconnected(ulong clientId)
    {
        if (NetworkManager.Singleton.IsServer) return;

        // Si se nos cae internet, Netcode nos echa y nos devuelve nuestro propio ID o 0
        if (clientId == 0 || clientId == NetworkManager.Singleton.LocalClientId)
        {
            Debug.LogWarning("[RoomsManager] ¡Caída de red detectada (WiFi)! Volviendo al menú principal...");
            StartCoroutine(ForcedDisconnectRoutine());
        }
    }

    private IEnumerator ForcedDisconnectRoutine()
    {
        if (NetworkManager.Singleton != null)
        {
            NetworkManager.Singleton.Shutdown();
            yield return new WaitWhile(() => NetworkManager.Singleton.ShutdownInProgress);
        }

        if (GlobalVariables.Instance != null)
            GlobalVariables.Instance.SetSelectedE3DModelData(null);

        Destroy(this.gameObject);
        
        UnityEngine.SceneManagement.SceneManager.LoadScene("MainScene");
    }

    // Añade esto al final de la clase para limpiar cuando salgas de la escena
    private void OnDestroy()
    {
        if (Instance == this)
            Instance = null;
    }

    /// <summary>
    /// Conecta a una sala seleccionada
    /// </summary>
    public void ConnectToRoom(int port)
    {
        Debug.Log($"[RoomsManager] Conectando a sala en puerto: {port}");
        RoomState.CurrentRoomPort = port;
        EnviarMensaje("SOLICITAR_UNIRSE", puerto: port, usuario: GlobalManagement.Instance.username);
    }
    
    public void LeaveRoom()
    {
        // Usamos el estado estático
        if (RoomState.CurrentRoomPort != -1)
        {
            string uname = GlobalManagement.Instance != null ? GlobalManagement.Instance.username : "Unknown";
            EnviarMensaje("SALIR_SALA", puerto: RoomState.CurrentRoomPort, usuario: uname);
            RoomState.CurrentRoomPort = -1; // Reseteamos el estado estático
        }

        if (NetworkManager.Singleton != null)
            NetworkManager.Singleton.Shutdown();
    }

    private void StartClientDelayed(string ip, ushort port)
    {
        // Acción encapsulada para conectar
        Action conectarAccion = () => 
        {
            if (NetworkManager.Singleton != null && (NetworkManager.Singleton.IsClient || NetworkManager.Singleton.IsServer))
            {
                Debug.LogWarning("[RoomsManager] NetworkManager estaba sucio. Forzando Shutdown...");
                NetworkManager.Singleton.Shutdown();
            }

            Debug.Log($"[RoomsManager] Iniciando conexión a {ip}:{port}");
            connectionManager.StartClient(ip, port);
        };

        if(XRFade.Instance == null)
            conectarAccion.Invoke();
        else
            StartCoroutine(WaitFadeAndConnect(conectarAccion));
    }
    
    private IEnumerator WaitFadeAndConnect(System.Action onConnect)
    {
        bool fadeCompleted = false;
        
        XRFade.Instance?.FadeOut(() => { fadeCompleted = true; });

        float timer = 0f;
        while (!fadeCompleted && timer < 2.0f)
        {
            timer += Time.deltaTime;
            yield return null;
        }

        if (!fadeCompleted) Debug.LogWarning("[RoomsManager] FadeOut timeout. Conectando forzosamente.");
        
        onConnect.Invoke();
    }

    
    /// <summary>
    /// Crea una nueva sala en el servidor
    /// </summary>
    public void CreateRoom(UnityAction<RespuestaServidor> onRoomCreated = null)
    {
        E3DModelData selectedModel = GlobalVariables.Instance.GetSelectedE3DModelData();
        
        Debug.Log($"[RoomsManager] CreateRoom iniciado. Modelo: {(selectedModel != null ? "OK" : "NULL")}");
        
        if (selectedModel == null)
        {
            Debug.LogError("[RoomsManager] No hay modelo seleccionado para crear la sala");
            return;
        }
        
        if (string.IsNullOrEmpty(GlobalManagement.Instance.username))
        {
            Debug.LogError("[RoomsManager] Username vacío");
            return;
        }
        
        //Comprobación de modo development local
        if(NetworkServerConfiguration.Instance.connectMode == ConnectMode.LOCAL)
        {
            //Esto significa que no hay una instancia de servidor corriendo, sino que estamos en multiplayer play mode, así que ejecutamos el direct connect
            DirectConnect();
            return;
        }
        
        bool isAudioRoom = GlobalVariables.Instance.GetIsAudioRoom();
        List<string> acceptedUsers = GlobalVariables.Instance.GetAcceptedUsers();
        
        Debug.Log($"[RoomsManager] ¿XRFade existe?: {XRFade.Instance != null}");
        
        if(XRFade.Instance == null)
        {
            Debug.Log("[RoomsManager] Enviando ABRIR_SALA sin fade...");
            EnviarMensaje("ABRIR_SALA", selectedModel.id, GlobalManagement.Instance.username, GlobalVariables.Instance.GetRoomName(), hasAudio:isAudioRoom, usuarios_aceptados: acceptedUsers, onRoomCreated: onRoomCreated);
        }
        else
        {
            Debug.Log("[RoomsManager] Iniciando FadeOut para abrir sala...");
            XRFade.Instance?.FadeOut(() =>
            {
                Debug.Log("[RoomsManager] Fade completado, enviando ABRIR_SALA...");
                EnviarMensaje("ABRIR_SALA", selectedModel.id, GlobalManagement.Instance.username, GlobalVariables.Instance.GetRoomName(), hasAudio:isAudioRoom, usuarios_aceptados: acceptedUsers, onRoomCreated: onRoomCreated);
            });
        }
        
    }
    
    /// <summary>
    /// Actualiza la lista de salas disponibles desde el servidor
    /// </summary>
    public void UpdateRooms()
    {
        EnviarMensaje("CONSULTAR_SERVIDORES", usuario: GlobalManagement.Instance.username);
    }
    
    /// <summary>
    /// Conecta directamente a un servidor (usado para testing)
    /// </summary>
    public void DirectConnect()
    {
        var commandLineArgumentsParser = new CommandLineArgumentsParser();
        ushort listeningPort = (ushort)commandLineArgumentsParser.Port;
        
        string address = NetworkServerConfiguration.Instance.getMatchmakingServerIP();

        StartClientDelayed(address, listeningPort);
        Debug.Log($"[RoomsManager] Conectando directamente a {address}:{listeningPort}");
    }

    /// <summary>
    /// Envía un mensaje al servidor de gestión de salas
    /// </summary>
    /// <param name="comando">Comando a enviar (ABRIR_SALA, CONSULTAR_SERVIDORES, CERRAR_SALA)</param>
    /// <param name="chelementID">ID del elemento (opcional)</param>
    /// <param name="creador">Nombre del creador de la sala (opcional)</param>
    /// <param name="nombreSala">Nombre de la sala (opcional)</param>
    /// <param name="puerto">Puerto de la sala (para CERRAR_SALA)</param>
    public void EnviarMensaje(string comando, int chelementID = -1, string creador = "", string nombreSala = "", int puerto = -1, bool hasAudio = false, List<string> usuarios_aceptados = null, string usuario = "", int cantidad = 0, UnityAction<RespuestaServidor> onRoomCreated = null)
    {
        // Validación de entrada
        if (string.IsNullOrEmpty(comando))
        {
            Debug.LogError("[RoomsManager] Comando vacío");
            return;
        }
        
        // Obtener dirección del servidor
        string serverIP = NetworkServerConfiguration.Instance.getMatchmakingServerIP();
        
        if (Application.isBatchMode)
            serverIP = "127.0.0.1";
        
        Debug.Log($"[RoomsManager] Conectando a {serverIP}:{PUERTO_SERVIDOR_MANAGER} con comando: {comando}");
        
        TcpClient cliente = new TcpClient();
        NetworkStream stream = null;
        
        try
        {
            // Conectar al servidor
            cliente.Connect(serverIP, PUERTO_SERVIDOR_MANAGER);
            cliente.ReceiveTimeout = (int)(tiempoTimeoutSocket * 1000);
            cliente.SendTimeout = (int)(tiempoTimeoutSocket * 1000);
            
            stream = cliente.GetStream();
            string safeToken = GlobalManagement.Instance != null ? GlobalManagement.Instance.token : "";
            string safeUser = string.IsNullOrEmpty(usuario) && GlobalManagement.Instance != null ? GlobalManagement.Instance.username : usuario;
            
            // Crear y serializar el mensaje
            var mensaje = new Mensaje
            {
                comando = comando,
                creador = creador,
                nombre_sala = nombreSala,
                chelementID = chelementID,
                bearerToken = safeToken,
                hasAudio = hasAudio,
                usuario =  safeUser,
                usuarios_aceptados = usuarios_aceptados ??  new List<string>(),
                cantidad = cantidad,
                puerto = puerto
            };

            var settings = new JsonSerializerSettings
            {
                NullValueHandling = NullValueHandling.Ignore,
                DefaultValueHandling = DefaultValueHandling.Ignore
            };

            string mensajeJson = JsonConvert.SerializeObject(mensaje, settings);
            byte[] data = Encoding.UTF8.GetBytes(mensajeJson);

            // Enviar el mensaje
            stream.Write(data, 0, data.Length);
            Debug.Log($"[RoomsManager] Mensaje enviado: {mensajeJson}");

            // Leer respuesta del servidor
            byte[] respuesta = new byte[tamanoBufferRespuesta];
            int bytesRead = stream.Read(respuesta, 0, respuesta.Length);
            
            if (bytesRead == 0)
            {
                Debug.LogError("[RoomsManager] El servidor cerró la conexión sin enviar datos");
                return;
            }
            
            string respuestaJson = Encoding.UTF8.GetString(respuesta, 0, bytesRead);
            Debug.Log($"[RoomsManager] Respuesta del servidor: {respuestaJson}");
            
            // Procesar la respuesta según el comando
            ProcesarRespuesta(comando, respuestaJson, serverIP, onRoomCreated);
        }
        catch (SocketException ex)
        {
            if (NetworkManager.Singleton != null && !NetworkManager.Singleton.IsServer)
                StartCoroutine(ShowErrorMessage("Cannot connect to the server."));
            
            Debug.LogError($"[RoomsManager] SocketException: {ex.Message}");
        }
        catch (JsonException ex)
        {
            Debug.LogError($"[RoomsManager] Error al deserializar JSON: {ex.Message}");
        }
        catch (Exception ex)
        {
            StartCoroutine(ShowErrorMessage("Unexpected network error."));
            Debug.LogError($"[RoomsManager] Error inesperado: {ex.Message}");
        }
        finally
        {
            // Limpiar recursos
            if (stream != null)
            {
                try { stream.Close(); }
                catch { }
            }
            
            if (cliente != null)
            {
                try { cliente.Close(); }
                catch { }
            }
        }
    }

    /// <summary>
    /// Procesa la respuesta del servidor según el tipo de comando
    /// </summary>
    private void ProcesarRespuesta(string comando, string respuestaJson, string serverIP, UnityAction<RespuestaServidor> onRoomCreated = null)
    {
        try
        {
            try
            {
                //Antes de procesar el comando debo verificar si la respuesta es un error genérico  
                ErrorMessage posibleError = JsonConvert.DeserializeObject<ErrorMessage>(respuestaJson);
                if (posibleError != null && !string.IsNullOrEmpty(posibleError.error))
                {
                    Debug.LogError($"[RoomsManager] Error del servidor: {posibleError.error}");
                    return;
                }
            }
            catch (Exception ex)
            {
                Debug.Log("[RoomsManager] La respuesta no es un mensaje de error genérico, procediendo a procesar el comando específico. Excepción: " + ex.Message);
            }
            
            switch (comando)
            {
                case "ABRIR_SALA":
                    ProcesarRespuestaAbrirSala(respuestaJson, onRoomCreated);
                    break;
                    
                case "CONSULTAR_SERVIDORES":
                    ProcesarRespuestaConsultarSalas(respuestaJson, serverIP);
                    break;
                    
                case "CERRAR_SALA":
                    ProcesarRespuestaCerrarSala(respuestaJson);
                    break;
                
                case "SOLICITAR_UNIRSE":
                    ProcesarRespuestaSolicitarUnirse(respuestaJson);
                    break;
                    
                default:
                    Debug.LogWarning($"[RoomsManager] Comando no manejado: {comando}");
                    break;
            }
        }
        catch (System.Exception ex)
        {
            Debug.LogError($"[RoomsManager] Error procesando respuesta: {ex.Message}");
        }
    }

    /// <summary>
    /// Procesa la respuesta de ABRIR_SALA
    /// </summary>
    private void ProcesarRespuestaAbrirSala(string respuestaJson, UnityAction<RespuestaServidor> onRoomCreated = null)
    {
        try
        {
            var respuesta = JsonConvert.DeserializeObject<RespuestaServidor>(respuestaJson);
            
            if (respuesta == null)
            {
                Debug.LogError("[RoomsManager] Respuesta deserializada es nula");
                return;
            }

            if (respuesta.status == "error")
            {
                Debug.LogError($"[RoomsManager] Error al abrir sala: {respuesta.mensaje}");
                StartCoroutine(ShowErrorMessage("Error creating the room."));
                return;
            }

            if (respuesta.status == "activo")
            {
                Debug.Log($"[RoomsManager] Sala creada correctamente. Puerto: {respuesta.puerto}");
                RoomState.CurrentRoomPort = respuesta.puerto;
                if(onRoomCreated != null)
                {
                    onRoomCreated.Invoke(respuesta);
                }
                // Actualizar lista de salas después de un breve delay
                //Invoke("UpdateRooms", delayActualizacionSalas);
            }
            else if (respuesta.status == "inactivo")
            {
                Debug.LogWarning($"[RoomsManager] Sala creada pero está inactiva: {respuesta.mensaje}");
            }
            else
            {
                Debug.LogWarning($"[RoomsManager] Status desconocido: {respuesta.status}");
            }
        }
        catch (JsonException ex)
        {
            Debug.LogError($"[RoomsManager] Error al deserializar respuesta ABRIR_SALA: {ex.Message}");
        }
    }

    /// <summary>
    /// Procesa la respuesta de CONSULTAR_SERVIDORES
    /// </summary>
    private void ProcesarRespuestaConsultarSalas(string respuestaJson, string serverIP)
    {
        // Es un array, lista de salas
        if (respuestaJson == lastRoomsJson)
            return;
        
        lastRoomsJson = respuestaJson;
        
        var salas = JsonConvert.DeserializeObject<List<Servicio>>(respuestaJson);
        if (salas == null)
        {
            Debug.LogWarning("[RoomsManager] No hay salas disponibles");
            salas = new List<Servicio>();
        }

        Debug.Log($"[RoomsManager] Salas activas encontradas: {salas.Count}");

        // Actualizar UI si está disponible
        if (_roomManagerUIDocController != null)
        {
            _roomManagerUIDocController.ClearRooms();
            foreach (var sala in salas)
            {
                _roomManagerUIDocController.AddRoom(
                    sala.nombre_sala,
                    sala.creador,
                    sala.puerto,
                    serverIP,
                    sala.chelementID,
                    sala.hasAudio,
                    sala.usuarios_aceptados,
                    sala.jugadores_actuales
                );
                Debug.Log($"[RoomsManager] Sala añadida a UI - Creador: {sala.creador}, " +
                    $"Nombre: {sala.nombre_sala}, Puerto: {sala.puerto}, " +
                    $"IP: {serverIP}, CHElementID: {sala.chelementID}, HasAudio: {sala.hasAudio}, " +
                    $"Usuarios aceptados: {sala.usuarios_aceptados}");
            }
        }
        else
        {
            Debug.LogWarning("[RoomsManager] RoomManagerUIDocController no está asignado");
        }
    }

    /// <summary>
    /// Procesa la respuesta de CERRAR_SALA
    /// </summary>
    private void ProcesarRespuestaCerrarSala(string respuestaJson)
    {
        try
        {
            var respuesta = JsonConvert.DeserializeObject<RespuestaServidor>(respuestaJson);
            
            if (respuesta == null)
            {
                Debug.LogError("[RoomsManager] Respuesta deserializada es nula");
                return;
            }

            if (respuesta.status == "error")
            {
                Debug.LogError($"[RoomsManager] Error al cerrar sala: {respuesta.mensaje}");
                return;
            }

            if (respuesta.status == "ok")
            {
                Debug.Log($"[RoomsManager] Sala cerrada correctamente: {respuesta.mensaje}");
                // Actualizar lista de salas
                Invoke("UpdateRooms", delayActualizacionSalas);
            }
        }
        catch (JsonException ex)
        {
            Debug.LogError($"[RoomsManager] Error al deserializar respuesta CERRAR_SALA: {ex.Message}");
        }
    }
    
    private void ProcesarRespuestaSolicitarUnirse(string respuestaJson)
    {
        var respuesta = JsonConvert.DeserializeObject<RespuestaServidor>(respuestaJson);
        
        if (respuesta != null && respuesta.status == "ok")
        {
            string ip = NetworkServerConfiguration.Instance.getMatchmakingServerIP();
            StartClientDelayed(ip, (ushort)respuesta.puerto);
        }
        else
        {
            Debug.LogWarning($"[RoomsManager] Permiso denegado: {respuesta?.mensaje}");
            StartCoroutine(ShowErrorMessage(respuesta?.mensaje));
        }
    }

    public IEnumerator ShowErrorMessage(string customMsg = null)
    {
        _roomManagerUIDocController.ShowErrorMessage(customMsg);
        yield return new WaitForSeconds(3f);
        _roomManagerUIDocController.BackToSelectRoom();
    }

    /// <summary>
    /// Corutina que refresca la lista de salas periódicamente
    /// </summary>
    public IEnumerator RefreshRooms()
    {
        while (true)
        {
            yield return new WaitForSeconds(5f);
            UpdateRooms();
        }
    }

    private void OnApplicationPause(bool pauseStatus)
    {
        if (pauseStatus)
            LeaveRoom();
    }

    private void OnApplicationQuit()
    {
        LeaveRoom();
    }
}