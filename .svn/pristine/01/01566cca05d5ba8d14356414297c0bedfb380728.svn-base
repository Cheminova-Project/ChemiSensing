using UnityEngine;

public class TriggerTool : ToolComponent
{
    protected override void OnToolActivatedInternal()
    {
        base.OnToolActivatedInternal();
        
        // Lógica de disparo (ej: Enviar mensaje)
        Debug.Log("Mensaje Enviado");

        // TRUCO: Desactivar inmediatamente el GameObject o la herramienta
        // para que no se quede "marcada" o activa visualmente.
        // Si controlas el estado visual por código:
        StartCoroutine(AutoDeactivate()); 
    }

    private System.Collections.IEnumerator AutoDeactivate()
    {
        yield return null; // Espera un frame
        //gameObject.SetActive(false); // O llama a tu lógica de deselección
        base.OnToolDeactivatedInternal();
    }
}