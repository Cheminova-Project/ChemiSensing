using UnityEngine;

/// <summary>
/// Gestiona las credenciales y el proceso de login del usuario.
/// </summary>
public class LoginManagement : MonoBehaviour
{
    /// <summary>
    /// Si es true, intenta iniciar sesión automáticamente al iniciar la app.
    /// </summary>
    public bool autoLogin;
    /// <summary>
    /// Nombre de usuario para login.
    /// </summary>
    [SerializeField] private string username;
    /// <summary>
    /// Contraseña para login.
    /// </summary>
    [SerializeField] private string password;

    /// <summary>
    /// Obtiene el nombre de usuario configurado.
    /// </summary>
    /// <returns>Nombre de usuario.</returns>
    public string GetUsername()
    {
        return username;
    }

    /// <summary>
    /// Obtiene la contraseña configurada.
    /// </summary>
    /// <returns>Contraseña.</returns>
    public string GetPassword()
    {
        return password;
    }

    public void SetUsername(string user)
    {
        username = user;
    }

    public void SetPassword(string pass)
    {
        password = pass;
    }
}
