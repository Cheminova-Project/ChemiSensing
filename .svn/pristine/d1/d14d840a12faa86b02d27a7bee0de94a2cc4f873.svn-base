using System.Collections;
using Unity.Netcode;
using UnityEngine;
using UnityEngine.UIElements;

/// <summary>
/// Componente que gestiona el botón de retorno a posición anterior,
/// haciendo que el Toggle funcione como un botón momentáneo (efecto rebote).
/// </summary>
public class ReturnToPosition : ToolComponent
{
    // IMPORTANTE: Asegúrate de que este nombre coincida con el 'name' de tu Toggle en el UXML
    private string buttonName = "return_position"; 
    
    private Toggle myToggle; 
    private bool isProcessing = false; 

    protected override void OnToolActivatedInternal()
    {
        base.OnToolActivatedInternal();

        if (uIDocument != null)
        {
            // 1. Buscamos el Toggle en la UI
            myToggle = uIDocument.rootVisualElement.Q<Toggle>(buttonName);

            if (myToggle != null)
            {
                // Limpieza preventiva
                myToggle.UnregisterValueChangedCallback(OnToggleValueChanged);

                // Configuración para que parezca un botón instantáneo
                myToggle.focusable = false;

                // Registrar el evento
                myToggle.RegisterValueChangedCallback(OnToggleValueChanged);
                
                // 2. Verificamos el estado PRESENTE.
                // Si el usuario activó la herramienta pulsando el toggle directamente
                if (myToggle.value == true && !isProcessing)
                {
                    StartCoroutine(ExecuteReturnProcess());
                }
            }
            else
            {
                Debug.LogWarning($"[ReturnToPosition] No se encontró el Toggle con nombre: {buttonName}");
            }
        }
    }

    protected override void OnToolDeactivatedInternal()
    {
        base.OnToolDeactivatedInternal();
        
        // Limpieza al cerrar la herramienta
        if (myToggle != null)
        {
            myToggle.UnregisterValueChangedCallback(OnToggleValueChanged);
            myToggle = null;
        }
    }

    private void OnToggleValueChanged(ChangeEvent<bool> evt)
    {
        // Solo actuamos si el valor es True (encendido) y no estamos procesando ya una acción
        if (evt.newValue == true && !isProcessing)
        {
            StartCoroutine(ExecuteReturnProcess());
        }
    }

    private IEnumerator ExecuteReturnProcess()
    {
        isProcessing = true;
        
        // Desactivar interacción visual temporalmente para evitar doble click rápido
        if (myToggle != null) myToggle.SetEnabled(false);

        // --- LÓGICA ORIGINAL DE RETORNO ---
        var localPlayerObj = NetworkManager.Singleton.SpawnManager.GetLocalPlayerObject();
        
        if (localPlayerObj != null)
        {
            var localController = localPlayerObj.GetComponent<UserControllerPlayer>();
            
            if (localController != null)
            {
                // Ejecutamos la acción de volver
                localController.BackToLastPos();
                Debug.Log("[ReturnToPosition] Volviendo a la última posición conocida.");
            }
        }
        else
        {
            Debug.LogWarning("[ReturnToPosition] No se encontró el objeto del jugador local.");
        }

        // Esperamos un poco para que se vea el "click" visualmente
        yield return new WaitForSeconds(0.25f); // 0.25s suele ser suficiente para feedback táctil

        // --- RESET / EFECTO REBOTE ---
        if (myToggle != null)
        {
            myToggle.SetEnabled(true);
            
            // Apagamos el toggle sin disparar eventos, dejándolo listo para el próximo uso
            myToggle.SetValueWithoutNotify(false);
        }
        
        isProcessing = false;
        
        Destroy(gameObject);
    }
}