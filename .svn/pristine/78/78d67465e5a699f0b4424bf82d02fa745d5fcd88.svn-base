<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="exit_popup_container" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.8); align-items: center; justify-content: center;">
        <ui:VisualElement style="width: 750px; background-color: rgb(240, 240, 240); border-radius: 12px; border-width: 2px; border-color: rgb(80, 80, 80); padding: 24px; padding-top: 20px; height: 320px;">
            <ui:Label text="EXIT OPTIONS" style="color: rgb(0, 0, 0); -unity-font-style: bold; font-size: 50px; -unity-text-align: middle-center; margin-bottom: 10px;"/>
            <ui:Label text="You are the room creator. Do you want to close the room for everyone or leave it open?" style="color: rgb(0, 0, 0); font-size: 32px; -unity-text-align: middle-center; white-space: normal; margin-bottom: 10px;"/>
            <ui:Label name="txt_countdown_warning" text="" style="color: rgb(190, 60, 60); font-size: 28px; -unity-font-style: bold; -unity-text-align: middle-center; margin-bottom: 15px;"/>
            <ui:VisualElement style="flex-direction: row; justify-content: space-around; width: 100%;">
                <ui:Button name="btn_close_room" text="Close Room" style="width: 200px; height: 60px; background-color: rgb(190, 60, 60); color: rgb(255, 255, 255); font-size: 20px; border-radius: 6px; border-width: 0;"/>
                <ui:Button name="btn_leave_open" text="Leave Open" style="width: 200px; height: 60px; background-color: rgb(100, 100, 100); color: rgb(255, 255, 255); font-size: 20px; border-radius: 6px; border-width: 0;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>