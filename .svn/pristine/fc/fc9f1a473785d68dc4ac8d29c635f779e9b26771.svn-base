using System;
using System.Collections.Generic;
using System.Linq;
using Unity.Netcode;
using UnityEngine;
using UnityEngine.Analytics;
using UnityEngine.UIElements;
using VInspector;

/// <summary>
/// Datos simplificados que se almacenan en cada item de textura UI
/// Solo mantiene la referencia al ID, el estado se consulta desde TextureManager
/// </summary>
[System.Serializable]
public class TextureItemData
{
    public int remoteTextureID;
    public RemoteTexture remoteTexture;
    public VisualElement uiElement; // Referencia al elemento UI creado
    
    // Referencias a callbacks para poder desuscribirse
    public System.Action downloadCallback;
    public System.Action visualizationCallback;
    
    public TextureItemData(RemoteTexture texture)
    {
        remoteTextureID = texture.id;
        remoteTexture = texture;
    }
}

/// <summary>
/// UI Manager para texturas usando UI Toolkit y heredando de ToolComponent
/// </summary>
public class TextureManagerUI : ToolComponent
{
    [Header("UI Toolkit References")]
    private UIDocument uiDocument;
    [SerializeField] private VisualTreeAsset textureItemAsset;
    [SerializeField] private Sprite loadIcon;
    [SerializeField] private Sprite downloadIcon;
    [SerializeField] private Sprite removeIcon;
    [SerializeField] private Sprite showIcon;
    [SerializeField] private Sprite hideIcon;
    
    private ScrollView texturesContainer;
    private VisualElement texturesContent;
    private DropdownField typeFilterDropdown;
    private TextureManager textureManager;
    
    private List<TextureItemData> textureItems = new List<TextureItemData>();
    
    private string downloadButtonID = "texture-download-button";
    private string visualizationButtonID = "texture-view-button";
    private string typeFilterDropdownName = "type-options";
    
    [Header("Timeout Settings")]
    [SerializeField] private float inactivityTimeoutSeconds = 15f;
    private float _lastInteractionTime;
    private bool _isTrackingInactivity = false;
    
    public static event Action<TextureManagerUI> OnTextureManagerUICreated;
    
    protected override void OnToolActivatedInternal()
    {
        base.OnToolActivatedInternal();
        InitializeUI();
        FindTextureManager();
        
        if (textureManager != null)
        {
            ulong currentOwner = textureManager.textureToolLockOwner.Value;
            ulong myId = NetworkManager.Singleton.LocalClientId;

            if (currentOwner != ulong.MaxValue && currentOwner != myId)
            {
                string ownerName = LocalRegistry.Instance != null ? LocalRegistry.Instance.GetClientUsername(currentOwner) : "Another user";
                
                if (ToolMessageHandler.Instance != null)
                    ToolMessageHandler.Instance.ShowMessage($"{ownerName} is currently using the Texture Tool.", 4f, MessageType.Error);

                if (ToolMenuController.Instance != null)
                    ToolMenuController.Instance.ForceCloseActiveGroupTool();
                
                return;
            }

            textureManager.RequestTextureToolLockServerRpc(myId);

            _isTrackingInactivity = true;
            ResetActivityTimer();
        }

        OnTextureManagerUICreated?.Invoke(this);
    }
    
    protected override void OnToolDeactivatedInternal()
    {
        base.OnToolDeactivatedInternal();
        
        _isTrackingInactivity = false;
        
        if (textureManager != null)
        {
            if (textureManager.textureToolLockOwner.Value == NetworkManager.Singleton.LocalClientId)
                textureManager.ReleaseTextureToolLockServerRpc(NetworkManager.Singleton.LocalClientId);
            
            textureManager.onRemoteTexturesValueChanged -= OnRemoteTextureChanged;
            textureManager.onTextureStartedDownload -= OnTextureStartedDownload;
            textureManager.onMemoryLimitReached -= OnMemoryLimitReached;
        }
        
        if (texturesContainer != null)
        {
            texturesContainer.UnregisterCallback<PointerMoveEvent>(OnUserInteraction);
            texturesContainer.UnregisterCallback<PointerDownEvent>(OnUserInteraction);
            texturesContainer.UnregisterCallback<WheelEvent>(OnUserInteraction);
        }
        
        if (typeFilterDropdown != null)
        {
            typeFilterDropdown.UnregisterValueChangedCallback(OnFilterChanged);
        }
    }

    private void InitializeUI()
    {
        uiDocument = transform.parent.GetComponent<UIDocument>();
        if (uiDocument == null)
        {
            Debug.LogError("[TextureManagerUI] UIDocument not assigned");
            return;
        }

        var root = uiDocument.rootVisualElement;
        texturesContainer = root.Q<ScrollView>("texture-list");
        
        if (texturesContainer == null)
        {
            Debug.LogError("[TextureManagerUI] Could not find 'texture-list' ScrollView element in UI");
            return;
        }

        texturesContent = texturesContainer.contentContainer;
        
        if (texturesContent == null)
        {
            Debug.LogError("[TextureManagerUI] Could not find content container in ScrollView");
            return;
        }
        
        typeFilterDropdown = root.Q<DropdownField>(typeFilterDropdownName);
        
        if (typeFilterDropdown != null)
        {
            typeFilterDropdown.RegisterValueChangedCallback(OnFilterChanged);
        }
        
        texturesContainer.RegisterCallback<PointerMoveEvent>(OnUserInteraction);
        texturesContainer.RegisterCallback<PointerDownEvent>(OnUserInteraction);
        texturesContainer.RegisterCallback<WheelEvent>(OnUserInteraction);
        
        Debug.Log("[TextureManagerUI] UI initialized successfully with ScrollView");
    }
    
    private void OnFilterChanged(ChangeEvent<string> evt)
    {
        ResetActivityTimer();
        UpdateVisibleList();
    }
    
    private void ResetActivityTimer()
    {
        _lastInteractionTime = Time.time;
    }

    private void FindTextureManager()
    {
        textureManager = FindFirstObjectByType<TextureManager>();
        
        if (textureManager == null)
        {
            Debug.LogError("[TextureManagerUI] TextureManager not found in scene");
            return;
        }

        // Suscribirse a eventos del TextureManager
        textureManager.onRemoteTexturesValueChanged += OnRemoteTextureChanged;
        textureManager.onTextureStartedDownload += OnTextureStartedDownload;
        textureManager.onMemoryLimitReached += OnMemoryLimitReached;
        
        Debug.Log("[TextureManagerUI] Connected to TextureManager");
    }
    
    private void Update()
    {
        if (_isTrackingInactivity && Time.time - _lastInteractionTime > inactivityTimeoutSeconds)
            ExitTextureToolDueToTimeout();
    }
    
    private void ExitTextureToolDueToTimeout()
    {
        if (ToolMessageHandler.Instance != null)
            ToolMessageHandler.Instance.ShowMessage("Texture tool closed due to inactivity.", 3f, MessageType.Info);
                
        _isTrackingInactivity = false;

        if (textureManager != null && textureManager.textureToolLockOwner.Value == NetworkManager.Singleton.LocalClientId)
            textureManager.ReleaseTextureToolLockServerRpc(NetworkManager.Singleton.LocalClientId);

        if (ToolMenuController.Instance != null)
        {
            ToolMenuController.Instance.ForceCloseActiveGroupTool();
            ToolMenuController.Instance.GoBackToPreviousMenu();
        }
    }

    /// <summary>
    /// Agrega un nuevo item de textura a la UI
    /// </summary>
    public void AddTextureItem(RemoteTexture remoteTexture)
    {
        if (texturesContent == null)
            return;
        
        if (GetTextureDataByID(remoteTexture.id) != null)
            return;
        
        Debug.Log($"[TextureManagerUI] Procesando textura '{remoteTexture.name}' - Tipo recibido: '{remoteTexture.layerType}'");

        var itemData = new TextureItemData(remoteTexture);
        var textureElement = CreateTextureElement(itemData);
        
        if (textureElement == null)
            return;

        SetupTextureItem(textureElement, itemData);
        itemData.uiElement = textureElement;
        textureItems.Add(itemData);
        UpdateVisibleList();
    }
    
    private void UpdateVisibleList()
    {
        if (texturesContent == null || typeFilterDropdown == null)
            return;

        texturesContent.Clear();
        string selectedFilter = typeFilterDropdown.value;

        if (selectedFilter == "All")
        {
            RenderGroupSection("RGB TEXTURES", "RGB");
            RenderGroupSection("INFRARED (IR)", "IR");
            RenderGroupSection("RTI TEXTURES", "RTI");
            RenderGroupSection("HYPERSPECTRAL", "Hyperspectral");
            
            var knownTypes = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "RGB", "IR", "RTI", "Hyperspectral" };
            
            var unknownItems = textureItems.Where(item => 
                !knownTypes.Contains(item.remoteTexture.layerType.ToString().Trim())).ToList();

            if (unknownItems.Count > 0)
            {
                Label groupHeader = new Label("UNCATEGORIZED TEXTURES");
                groupHeader.style.fontSize = 24;
                groupHeader.style.unityFontStyleAndWeight = FontStyle.Bold;
                groupHeader.style.color = new Color(0.9f, 0.4f, 0.1f);
                groupHeader.style.marginTop = 15;
                groupHeader.style.marginBottom = 5;
                groupHeader.style.marginLeft = 15;
                
                texturesContent.Add(groupHeader);

                foreach (var item in unknownItems)
                {
                    texturesContent.Add(item.uiElement);
                }
            }
        }
        else
        {
            foreach (var item in textureItems)
            {
                if (item.remoteTexture.layerType.ToString().Equals(selectedFilter, StringComparison.OrdinalIgnoreCase))
                {
                    texturesContent.Add(item.uiElement);
                }
            }
        }
    }

    private void RenderGroupSection(string groupName, string typeFilter)
    {
        var filtered = textureItems.Where(item => 
            item.remoteTexture.layerType.ToString().Equals(typeFilter, StringComparison.OrdinalIgnoreCase)).ToList();
            
        if (filtered.Count == 0) return;

        Label groupHeader = new Label(groupName);
        groupHeader.style.fontSize = 24;
        groupHeader.style.unityFontStyleAndWeight = FontStyle.Bold;
        groupHeader.style.color = new Color(0.07f, 0.67f, 0.76f);
        groupHeader.style.marginTop = 15;
        groupHeader.style.marginBottom = 5;
        groupHeader.style.marginLeft = 15;
        
        texturesContent.Add(groupHeader);

        foreach (var item in filtered)
        {
            texturesContent.Add(item.uiElement);
        }
    }

    /// <summary>
    /// Crea un elemento visual para una textura
    /// </summary>
    private VisualElement CreateTextureElement(TextureItemData data)
    {
        if (textureItemAsset == null)
            return null;

        var textureElement = textureItemAsset.CloneTree();
        textureElement.userData = data;
        
        return textureElement;
    }

    /// <summary>
    /// Configura un elemento de textura con sus datos y eventos
    /// </summary>
    private void SetupTextureItem(VisualElement element, TextureItemData data)
    {
        // Buscar elementos hijo
        var nameLabel = element.Q<Label>("texture-name");
        var downloadButton = element.Q<Button>(downloadButtonID);
        var visualizationButton = element.Q<Button>(visualizationButtonID);
        var previewImage = element.Q<Image>("texture-preview");

        // Configurar nombre
        if (nameLabel != null)
            nameLabel.text = data.remoteTexture.name.ToString();

        // Configurar botón de descarga
        if (downloadButton != null)
        {
            // Limpiar eventos existentes si existen
            if (data.downloadCallback != null)
                downloadButton.clicked -= data.downloadCallback;
            
            // Crear y almacenar nuevo callback
            data.downloadCallback = () => OnDownloadButtonClicked(data);
            downloadButton.clicked += data.downloadCallback;
            UpdateDownloadButtonIcon(downloadButton, data);
        }

        // Configurar botón de visualización
        if (visualizationButton != null)
        {
            // Limpiar eventos existentes si existen
            if (data.visualizationCallback != null)
                visualizationButton.clicked -= data.visualizationCallback;
            
            // Crear y almacenar nuevo callback
            data.visualizationCallback = () => OnVisualizationButtonClicked(data);
            visualizationButton.clicked += data.visualizationCallback;
            UpdateVisualizationButton(visualizationButton, data);
        }

        // Configurar imagen preview si existe
        if (previewImage != null)
            previewImage.image = null;
    }

    /// <summary>
    /// Maneja el click en el botón de descarga
    /// </summary>
    private void OnDownloadButtonClicked(TextureItemData data)
    {
        ResetActivityTimer();
        
        if (textureManager == null)
            return;

        bool isDownloaded = textureManager.IsTextureDownloaded(data.remoteTextureID);
        bool isDownloading = textureManager.IsTextureDownloading(data.remoteTextureID);

        if (isDownloaded)
        {
            // Si ya está descargada, remover
            textureManager.RemoveTexture(data.remoteTextureID);
            // NO llamar RefreshTextureItem aquí, se actualizará por el evento del servidor
        }
        else if (!isDownloading)
        {
            // Si no está descargada ni descargándose, iniciar descarga
            textureManager.StartDownload(data.remoteTextureID, () => OnTextureDownloaded(data));
            
            // Refrescar inmediatamente para mostrar el estado de descarga
            RefreshTextureItem(data.remoteTextureID);
        }
    }

    /// <summary>
    /// Maneja el click en el botón de visualización
    /// </summary>
    private void OnVisualizationButtonClicked(TextureItemData data)
    {
        ResetActivityTimer();
        
        if (textureManager == null)
            return;

        // Solo permitir toggle si la textura está descargada
        bool isDownloaded = textureManager.IsTextureDownloaded(data.remoteTextureID);
        if (isDownloaded)
            textureManager.ToggleTextureVisibility(data.remoteTextureID);
    }

    /// <summary>
    /// Callback cuando una textura termina de descargarse
    /// </summary>
    private void OnTextureDownloaded(TextureItemData data)
    {
        RefreshTextureItem(data.remoteTextureID);
    }

    /// <summary>
    /// Callback cuando una textura empieza a descargarse
    /// </summary>
    private void OnTextureStartedDownload(int textureID)
    {
        RefreshTextureItem(textureID);
    }

    /// <summary>
    /// Callback cuando cambia una textura remota
    /// </summary>
    private void OnRemoteTextureChanged(RemoteTexture remoteTexture)
    {
        var data = GetTextureDataByID(remoteTexture.id);
        if (data != null)
        {
            data.remoteTexture = remoteTexture;
            RefreshTextureItem(remoteTexture.id);
        }
    }

    /// <summary>
    /// Callback cuando se alcanza el límite de memoria al intentar descargar
    /// </summary>
    private void OnMemoryLimitReached(int lruTextureID)
    {
        if (lruTextureID == -1)
            ToolMessageHandler.Instance.ShowMessage("All downloaded textures are in use. Cannot download more.", messageType: MessageType.Error);
        else
        {
            RemoteTexture lruTexture = textureManager.GetRemoteTextureByID(lruTextureID);
            ToolMessageHandler.Instance.ShowMessage($"Memory limit reached (max 3). Suggested to remove: '{lruTexture.name}'", messageType: MessageType.Error);
        }
    }

    /// <summary>
    /// Actualiza el icono del botón de descarga según el estado
    /// </summary>
    private void UpdateDownloadButtonIcon(Button button, TextureItemData data)
    {
        if (button == null || textureManager == null)
            return;

        bool isDownloading = textureManager.IsTextureDownloading(data.remoteTextureID);
        bool isDownloaded = textureManager.IsTextureDownloaded(data.remoteTextureID);

        // Configurar icono y estado según la situación
        if (isDownloading)
        {
            // Mostrando loading
            button.style.backgroundImage = new StyleBackground(loadIcon);
            button.SetEnabled(false);
        }
        else if (isDownloaded)
        {
            // Mostrando icono de remover
            button.style.backgroundImage = new StyleBackground(removeIcon);
            button.SetEnabled(true);
        }
        else
        {
            // Mostrando icono de descarga
            button.style.backgroundImage = new StyleBackground(downloadIcon);
            button.SetEnabled(true);
        }
    }

    /// <summary>
    /// Actualiza el botón de visualización según el estado
    /// </summary>
    private void UpdateVisualizationButton(Button button, TextureItemData data)
    {
        if (button == null || textureManager == null) return;

        bool isDownloaded = textureManager.IsTextureDownloaded(data.remoteTextureID);

        if (!isDownloaded)
        {
            // Si no está descargada, deshabilitar botón
            button.SetEnabled(false);
            button.style.backgroundImage = new StyleBackground(hideIcon);
            button.style.opacity = 0.5f; // Hacer visualmente que está deshabilitado
        }
        else
        {
            // Si está descargada, habilitar y mostrar icono apropiado
            button.SetEnabled(true);
            button.style.opacity = 1.0f;
            button.style.backgroundImage = data.remoteTexture.isVisible ? new StyleBackground(showIcon) : new StyleBackground(hideIcon);
        }
    }


    /// <summary>
    /// Establece la imagen preview para una textura específica
    /// </summary>
    public void SetPreviewImage(int textureID, Texture2D texture)
    {
        var data = GetTextureDataByID(textureID);
        if (data?.uiElement != null)
        {
            var previewImage = data.uiElement.Q<Image>("texture-preview");
            if (previewImage != null)
            {
                previewImage.image = texture;
            }
        }
    }

    /// <summary>
    /// Obtiene los datos de una textura por su ID
    /// </summary>
    private TextureItemData GetTextureDataByID(int textureID)
    {
        return textureItems.FirstOrDefault(item => item.remoteTextureID == textureID);
    }

    /// <summary>
    /// Refresca un elemento específico en el ScrollView
    /// </summary>
    private void RefreshTextureItem(int textureID)
    {
        var data = GetTextureDataByID(textureID);
        if (data?.uiElement != null)
        {
            // Actualizar datos primero
            data.remoteTexture = textureManager.GetRemoteTextureByID(textureID);
            
            // Solo actualizar los iconos y estados, NO reconfigurar los eventos
            var downloadButton = data.uiElement.Q<Button>(downloadButtonID);
            var visualizationButton = data.uiElement.Q<Button>(visualizationButtonID);
            
            if (downloadButton != null)
                UpdateDownloadButtonIcon(downloadButton, data);
            
            if (visualizationButton != null)
                UpdateVisualizationButton(visualizationButton, data);
        }
    }

    /// <summary>
    /// Limpia todos los items de textura
    /// </summary>
    public void ClearAllItems()
    {
        // Limpiar elementos del contenedor
        if (texturesContent != null)
            texturesContent.Clear();
        
        // Limpiar datos
        textureItems.Clear();
    }

    /// <summary>
    /// Remueve un item específico de textura
    /// </summary>
    public void RemoveTextureItem(int textureID)
    {
        var data = GetTextureDataByID(textureID);
        if (data?.uiElement != null)
        {
            // Remover del contenedor visual
            data.uiElement.RemoveFromHierarchy();

            // Remover de la lista de datos
            textureItems.Remove(data);
        }
    }

    /// <summary>
    /// Método para resetear desde TextureManager
    /// </summary>
    public void ResetUI()
    {
        ClearAllItems();
    }

    /// <summary>
    /// Refresca todos los elementos de la UI basándose en el estado actual del TextureManager
    /// </summary>
    public void RefreshAllUIStates()
    {
        if (textureManager == null) return;

        foreach (var itemData in textureItems)
        {
            itemData.remoteTexture = textureManager.GetRemoteTextureByID(itemData.remoteTextureID);
            if (itemData.uiElement != null)
                SetupTextureItem(itemData.uiElement, itemData);
        }
        
        UpdateVisibleList();
        
        Debug.Log("[TextureManagerUI] All UI states refreshed from TextureManager");
    }

    private void OnUserInteraction(EventBase evt)
    {
        if (_isTrackingInactivity)
            ResetActivityTimer();
    }
}