<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/rooms.uss?fileID=7433441132597879392&amp;guid=3206ad872bc42f34e89b8646dfc3ac4a&amp;type=3#rooms"/>
    <Style src="project://database/Assets/UI/USS/utils.uss?fileID=7433441132597879392&amp;guid=03b52ca0672e26748b8fdddb1dcce61b&amp;type=3#utils"/>
    <ui:VisualElement name="background" style="flex-grow: 1; background-color: rgb(255, 255, 255); width: 100%; height: 100%; min-width: 100%; min-height: 100%;">
        <ui:VisualElement name="room-container-parent" style="flex-grow: 2;">
            <ui:VisualElement name="top-bar" style="flex-grow: 0; height: 75px; flex-direction: row; background-color: rgb(18, 171, 195); min-height: 10%;">
                <ui:Button name="back-button" icon-image="project://database/Assets/CheminovaUI/Resources/UI/Icons/general/arrow_back.png?fileID=2800000&amp;guid=cd0a088107cba2b40a439dc8d6a5f3bf&amp;type=3#arrow_back" class="rounded-button" style="width: auto; height: auto; min-width: 75px; max-width: 150px; padding-top: 9px; margin-top: 10px; margin-bottom: 10px; margin-left: 10px; margin-right: 10px;"/>
                <AutoSizeLabel text="Room list" group="titles" style="-unity-text-align: middle-center; flex-grow: 1; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Mulish/static/Mulish-Regular.ttf?fileID=12800000&amp;guid=722f676cd3b8d41469ff5fc9c286d6a3&amp;type=3#Mulish-Regular&quot;); height: auto; -unity-font-style: bold; font-size: 80px;"/>
            </ui:VisualElement>
            <ui:ScrollView name="room-container" style="flex-grow: 1;"/>
        </ui:VisualElement>
        <ui:VisualElement name="buttons-container" style="flex-grow: 0;">
            <ui:Button name="direct-connect" class="rounded-button" style="min-height: 100px; justify-content: center; align-content: center; align-items: center; align-self: stretch;">
                <AutoSizeLabel text="Direct connect" max-font-size="80" style="position: absolute; width: 100%; height: 70%; top: auto; left: auto; align-content: center; align-items: center; bottom: auto; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Mulish/static/Mulish-Bold.ttf?fileID=12800000&amp;guid=fd0307a780a3b2347bcc299540a23ab8&amp;type=3#Mulish-Bold&quot;);"/>
            </ui:Button>
            <ui:Button name="update-rooms" class="rounded-button" style="min-height: 100px; justify-content: center; align-content: center; align-items: center; align-self: stretch;">
                <AutoSizeLabel text="Update rooms" max-font-size="80" style="position: absolute; width: 100%; height: 70%; top: auto; left: auto; align-content: center; align-items: center; bottom: auto; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Mulish/static/Mulish-Bold.ttf?fileID=12800000&amp;guid=fd0307a780a3b2347bcc299540a23ab8&amp;type=3#Mulish-Bold&quot;);"/>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="creating-room-panel" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; background-color: rgb(18, 171, 195); align-self: center; justify-content: center; align-content: center; display: none;">
        <AutoSizeLabel min-font-size="20" text="The room is being created&#10;Please wait..." style="width: 90%; height: 90%; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Mulish/static/Mulish-Regular.ttf?fileID=12800000&amp;guid=722f676cd3b8d41469ff5fc9c286d6a3&amp;type=3#Mulish-Regular&quot;); -unity-text-align: middle-center; align-self: center; justify-content: center; align-content: center;"/>
    </ui:VisualElement>
    <ui:VisualElement name="error-room-panel" style="flex-grow: 1; position: absolute; width: 90%; height: 80%; background-color: rgb(242, 189, 102); align-self: center; justify-content: center; align-content: center; display: none; top: 10%; bottom: auto; left: auto; right: auto;">
        <AutoSizeLabel min-font-size="20" text="Error creating the room...&#10;Please, try again" style="width: 90%; height: 90%; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Mulish/static/Mulish-Regular.ttf?fileID=12800000&amp;guid=722f676cd3b8d41469ff5fc9c286d6a3&amp;type=3#Mulish-Regular&quot;); -unity-text-align: middle-center; align-self: center; justify-content: center; align-content: center;"/>
    </ui:VisualElement>
</ui:UXML>
