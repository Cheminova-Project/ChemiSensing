:root {
    background-color: white;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    width: 100%;
}

.header {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 28px;
    position: absolute;
    top: 0;
    left: 0;
    padding-top: 26px;
    padding-right: 26px;
    padding-bottom: 26px;
    padding-left: 26px;
}

.left-section {
    flex-direction: row;
    align-items: center;
}

.right-section {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.logo {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    background-image: url("project://database/Assets/CheminovaUI/Resources/UI/Icons/logo/05_ANAGRAMA_Cheminova_NegroColor.png?fileID=2800000&guid=71bdf5c5655a29f489e2257f80daef7d&type=3#05_ANAGRAMA_Cheminova_NegroColor");
    -unity-background-scale-mode: scale-to-fit;
}

.register-text {
    font-size: 20px;
    margin-right: 30px;
}

.primary-link {
    font-size: 14px;
    color: blue;
    -unity-font-style: bold;
}

.container {
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding: 30px 0;
}

.container_login {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
}

.bold-heading {
    font-size: 100px;
    -unity-font-style: bold;
    margin: 15px 0;
}

.regular-text {
    font-size: 30px;
    color: gray;
    margin: 10px 0 25px;
    -unity-font-style: normal;
}

.input-label {
    font-size: 40px;
    margin: 12px 0 6px;
    -unity-text-align: middle-left;
}

.text-input {
    width: 100%;
    padding: 14px;
    margin: 8px 0 18px;
    border-left-color: rgb(204, 204, 204);
    border-right-color: rgb(204, 204, 204);
    border-top-color: rgb(204, 204, 204);
    border-bottom-color: rgb(204, 204, 204);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    font-size: 16px;
}

.forgot-password {
    font-size: 14px;
    color: blue;
    -unity-text-align: middle-left;
    margin-top: -5px;
}

.continue-button {
    width: 100%;
    padding: 14px;
    background-color: rgb(51, 51, 51);
    color: white;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 5px;
    font-size: 40px;
}

.continue-button:hover {
    background-color: rgb(85, 85, 85);
}

#email-error,
#password-error {
    color: red;
    font-size: 20px;
}

.footer {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 28px;
    position: absolute;
    bottom: 0;
    left: 0;
}


