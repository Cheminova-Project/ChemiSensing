using System;
using UnityEngine;
using UnityEngine.SceneManagement;

/// <summary>
/// Versión mejorada del gestor de selección de objetos E3D en la UI.
/// Permite seleccionar y manipular elementos E3D con funcionalidades adicionales.
/// </summary>
public class E3DSelectionHandlerv2 : MonoBehaviour
{
    /// <summary>
    /// Referencia al objeto seleccionado.
    /// </summary>
    public object selectedObject;

    private void Awake()
    {
        E3DListUI.onE3DModelSelected += OnE3DModelSelected;
    }

    public void OnE3DModelSelected(E3DModelData e3DModelData)
    {
        if (e3DModelData == null)
        {
            Debug.LogWarning("E3DModelData is null. Cannot handle selection.");
            return;
        }
        GlobalVariables.Instance.SetSelectedE3DModelData(e3DModelData);
        // Aquí puedes manejar la selección del modelo E3D
        Debug.Log($"E3D Model Selected: {e3DModelData.name}");
        
        UIDocumentManager.Instance.SwitchContext("room-config");    
    }
}
