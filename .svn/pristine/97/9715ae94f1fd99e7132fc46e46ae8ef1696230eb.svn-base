using UnityEngine;
using UnityEngine.InputSystem;

[CreateAssetMenu(menuName = "Desktop/Keyboard Input Action References")]
public class KeyBoardInputActionReferences : ScriptableObject
{
    [SerializeField] private InputActionProperty _openMenu;

    public InputActionProperty OpenMenu
    {
        get => _openMenu;
        set => _openMenu = value;
    }
}
