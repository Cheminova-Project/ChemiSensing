using System;
using UnityEngine;
using UnityEngine.UIElements;
using System.Collections.Generic;
using System.Linq;

public class RulerUI : ToolComponent
{
    string addSegmentButtonName = "add-segment-button";
    string deletePointsButtonName = "delete-points-button";
    string segmentsContainerName = "segments-container";
    string segmentStartDropdown = "segment-start";
    string segmentEndDropdown = "segment-end";
    string segmentDistanceLabel = "segment-length";
    string highlightButtonName = "highlight-button";
    string deleteSegmentButtonName = "delete-button";
    string directConnectionToggleName = "direct-connection-toggle";
    string shareSegmentToggleName = "share-segment-toggle";

    [SerializeField] private VisualTreeAsset segmentEntryTemplate;
    [SerializeField] private Ruler ruler;

    private Button addSegmentButton;
    private Button deletePointsButton;

    private class SegmentEntryData
    {
        public VisualElement entry;
        public DropdownField startDropdown;
        public DropdownField endDropdown;
        public Label distanceLabel;
        public Button highlightButton;
        public Button deleteButton;
        public Toggle directConnectionToggle;
        public Toggle shareSegmentToggle;
        public EventCallback<ChangeEvent<string>> startCallback;
        public EventCallback<ChangeEvent<string>> endCallback;
        public Action highlightAction;
        public Action deleteAction;
        public EventCallback<ChangeEvent<bool>> directConnectionCallback;
        public EventCallback<ChangeEvent<bool>> shareSegmentCallback;
        public Vector2Int currentSegment;
    }

    protected override void OnEnable()
    {
        base.OnEnable();
        
        if (ruler == null || !ruler.isActiveAndEnabled)
        {
            ruler = FindFirstObjectByType<Ruler>();
            if (ruler == null)
            {
                Debug.LogWarning("[RulerUI] No se ha encontrado ningún componente Ruler activo en la escena.");
            }
        }

        Ruler.OnPointAdded += OnRulerPointAdded;
        Ruler.OnPointsReset += OnRulerPointsReset;
        Ruler.OnSharedSegmentDeleted += HandleSharedSegmentDeleted;

        addSegmentButton = uIDocument.rootVisualElement.Q<Button>(addSegmentButtonName);
        addSegmentButton.clicked -= OnAddSegmentButtonClicked;
        addSegmentButton.clicked += OnAddSegmentButtonClicked;

        deletePointsButton = uIDocument.rootVisualElement.Q<Button>(deletePointsButtonName);
        deletePointsButton.clicked -= ruler.ResetRuler;
        deletePointsButton.clicked += ruler.ResetRuler;

        if (ruler.GetPointCount() < 2)
        {
            addSegmentButton.SetEnabled(false);
            ToolMessageHandler.Instance.ShowMessage("Add at least 2 points to create segments.", 4f, MessageType.Error);
        }
        else
        {
            addSegmentButton.SetEnabled(true);
        }

        var savedSegments = ruler.GetSavedSegments();
        FillSegments(savedSegments);
    }

    protected override void OnDisable()
    {
        base.OnDisable();
        
        Ruler.OnPointAdded -= OnRulerPointAdded;
        Ruler.OnPointsReset -= OnRulerPointsReset;
        Ruler.OnSharedSegmentDeleted -= HandleSharedSegmentDeleted;
    }

    private void OnRulerPointAdded()
    {
        UpdateAllSegmentDropdowns();

        if (addSegmentButton.enabledSelf == false && ruler.GetPointCount() >= 2)
        {
            addSegmentButton.SetEnabled(true);
            ToolMessageHandler.Instance.ShowMessage("You can now add segments between points.", 4f, MessageType.Info);
        }
    }

    private void OnRulerPointsReset()
    {
        //Limpiamos todos los segmentos, ya que los puntos se han eliminado
        VisualElement segmentsContainer = uIDocument.rootVisualElement.Q<VisualElement>(segmentsContainerName);
        if (segmentsContainer == null) return;
        segmentsContainer.Clear();
        addSegmentButton.SetEnabled(false);
        ToolMessageHandler.Instance.ShowMessage("Add at least 2 points to create segments.", 4f, MessageType.Error);
    }

    private void OnAddSegmentButtonClicked()
    {
        AddSegmentEntry();
    }

    private void FillSegments(List<Vector2Int> segments)
    {
        if (uIDocument == null || uIDocument.rootVisualElement == null || segments == null || segments.Count == 0)
            return;

        VisualElement segmentsContainer = uIDocument.rootVisualElement.Q<VisualElement>(segmentsContainerName);
        if (segmentsContainer == null) return;

        foreach (var child in segmentsContainer.Children().ToList())
        {
            child.RemoveFromHierarchy();
        }
        string segmentsDebug = string.Join(", ", segments.Select(s => $"({s.x}, {s.y})"));
        Debug.Log($"[RulerUI] Restoring saved segments: {segmentsDebug}");
        foreach (var segment in segments)
        {
            AddSegmentEntry(segment);
        }
    }

    private void AddSegmentEntry(Vector2Int segment = default)
    {
        VisualElement segmentsContainer = uIDocument.rootVisualElement.Q<VisualElement>(segmentsContainerName);
        if (segmentsContainer == null || segmentEntryTemplate == null)
            return;

        VisualElement newEntry = segmentEntryTemplate.CloneTree();
        segmentsContainer.Add(newEntry);

        DropdownField startDropdown = newEntry.Q<DropdownField>(segmentStartDropdown);
        DropdownField endDropdown = newEntry.Q<DropdownField>(segmentEndDropdown);
        Label distanceLabel = newEntry.Q<Label>(segmentDistanceLabel);
        distanceLabel.text = "0.00 cm";

        var entryData = new SegmentEntryData();
        entryData.entry = newEntry;
        entryData.startDropdown = startDropdown;
        entryData.endDropdown = endDropdown;
        entryData.distanceLabel = distanceLabel;
        entryData.currentSegment = segment;

        if (startDropdown != null)
        {
            EventCallback<ChangeEvent<string>> scb = evt => OnSegmentStartChanged(startDropdown, endDropdown);
            startDropdown.RegisterValueChangedCallback(scb);
            entryData.startCallback = scb;
        }

        if (endDropdown != null)
        {
            EventCallback<ChangeEvent<string>> ecb = evt => OnSegmentPointChanged(startDropdown, endDropdown);
            endDropdown.RegisterValueChangedCallback(ecb);
            entryData.endCallback = ecb;
        }

        UpdateSegmentDropdowns(startDropdown, endDropdown);

        if (segment != default)
        {
            int startIdx = FindPointIndexInDropdown(startDropdown, segment.x);
            int endIdx = FindPointIndexInDropdown(endDropdown, segment.y);

            if (startIdx != -1)
                startDropdown.index = startIdx;
            if (endIdx != -1)
                endDropdown.index = endIdx;
        }

        var localHighlight = newEntry.Q<Button>(highlightButtonName);
        if (localHighlight != null)
        {
            entryData.highlightButton = localHighlight;
            entryData.highlightAction = () => OnHighlightButtonClicked(newEntry);
            localHighlight.userData = newEntry;
            localHighlight.clicked += entryData.highlightAction;
        }

        var localDelete = newEntry.Q<Button>(deleteSegmentButtonName);
        if (localDelete != null)
        {
            entryData.deleteButton = localDelete;
            entryData.deleteAction = () => OnDeleteSegmentButtonClicked(newEntry);
            localDelete.userData = newEntry;
            localDelete.clicked += entryData.deleteAction;
        }

        var localConnection = newEntry.Q<Toggle>(directConnectionToggleName);
        if (localConnection != null)
        {
            entryData.directConnectionToggle = localConnection;
            EventCallback<ChangeEvent<bool>> dct = evt => OnDirectConnectionToggleChanged(localConnection);
            localConnection.RegisterValueChangedCallback(dct);
            entryData.directConnectionCallback = dct;
            localConnection.userData = newEntry;
        }
        
        var localShareSegment = newEntry.Q<Toggle>(shareSegmentToggleName);
        if (localShareSegment != null)
        {
            entryData.shareSegmentToggle = localShareSegment;
            EventCallback<ChangeEvent<bool>> sst = evt => OnShareSegmentToggleChanged(localShareSegment);
            localShareSegment.RegisterValueChangedCallback(sst);
            entryData.shareSegmentCallback = sst;
            localShareSegment.userData = newEntry;
        }

        newEntry.userData = entryData;
    }

    /// <summary>
    /// Busca en las opciones del dropdown qué índice contiene un punto específico
    /// </summary>
    private int FindPointIndexInDropdown(DropdownField dropdown, int pointNumber)
    {
        if (dropdown == null || dropdown.choices == null)
            return -1;

        for (int i = 0; i < dropdown.choices.Count; i++)
        {
            if (int.TryParse(dropdown.choices[i], out int choice) && choice == pointNumber)
            {
                return i;
            }
        }

        Debug.LogWarning($"[RulerUI] Point {pointNumber} not found in dropdown choices");
        return -1;
    }

    private void UpdateAllSegmentDropdowns()
    {
        if (uIDocument == null || uIDocument.rootVisualElement == null)
            return;
        VisualElement segmentsContainer = uIDocument.rootVisualElement.Q<VisualElement>(segmentsContainerName);
        if (segmentsContainer == null) return;

        var entries = segmentsContainer.Children();
        foreach (var entry in entries)
        {
            DropdownField startDropdown = entry.Q<DropdownField>(segmentStartDropdown);
            DropdownField endDropdown = entry.Q<DropdownField>(segmentEndDropdown);
            
            if (startDropdown != null && endDropdown != null)
            {
                UpdateSegmentDropdowns(startDropdown, endDropdown);
            }
        }
    }

    private void UpdateSegmentDropdowns(DropdownField startDropdown, DropdownField endDropdown)
    {
        int pointCount = ruler.GetPointCount();

        List<string> startOptions = new List<string>();
        for (int i = 1; i <= pointCount - 1; i++)
        {
            startOptions.Add($"{i}");
        }
        startDropdown.choices = startOptions;

        UpdateEndDropdown(startDropdown, endDropdown);
    }

    private void UpdateEndDropdown(DropdownField startDropdown, DropdownField endDropdown)
    {
        int pointCount = ruler.GetPointCount();
        int startIndex = startDropdown.index;

        List<string> endOptions = new List<string>();
        
        for (int i = startIndex + 2; i <= pointCount; i++)
        {
            endOptions.Add($"{i}");
        }

        endDropdown.choices = endOptions;
        
        if (endDropdown.index >= endOptions.Count)
        {
            endDropdown.index = -1;
        }
    }

    private void OnSegmentStartChanged(DropdownField startDropdown, DropdownField endDropdown)
    {
        UpdateEndDropdown(startDropdown, endDropdown);
        OnSegmentPointChanged(startDropdown, endDropdown);
    }

    private void OnSegmentPointChanged(DropdownField startDropdown, DropdownField endDropdown)
    {
        if (ruler == null || startDropdown.index == -1 || endDropdown.index == -1)
            return;

        string startText = startDropdown.choices[startDropdown.index];
        string endText = endDropdown.choices[endDropdown.index];
        
        if (!int.TryParse(startText, out int startPoint) || 
            !int.TryParse(endText, out int endPoint))
        {
            Debug.LogError("[RulerUI] Failed to parse dropdown values");
            return;
        }
        
        VisualElement parent = endDropdown.parent;
        while (parent != null && parent.userData == null)
            parent = parent.parent;

        SegmentEntryData entryData = parent?.userData as SegmentEntryData;
        if (entryData == null)
        {
            Debug.LogError("[RulerUI] No se pudo encontrar entryData.");
            return;
        }

        bool isDirectConnection = entryData.directConnectionToggle != null ? entryData.directConnectionToggle.value : false;
        
        Vector2Int newSegment = new Vector2Int(startPoint, endPoint);
        Vector2Int oldSegment = entryData.currentSegment;

        if (oldSegment != newSegment)
        {
            Debug.Log($"[RulerUI] Segment changed from {oldSegment} to {newSegment}");
            
            if (oldSegment != default)
                ruler.RemoveSavedSegment(oldSegment.x, oldSegment.y);
            
            ruler.AddSavedSegment(newSegment.x, newSegment.y);
            entryData.currentSegment = newSegment;
        }

        float distance = ruler.GetDistanceBetweenPoints(startPoint, endPoint, isDirectConnection);
        ruler.HighlightSegment(startPoint, endPoint, isDirectConnection);

        Label distanceLabel = parent.Q<Label>(segmentDistanceLabel);
        if (distanceLabel != null)
        {
            distanceLabel.text = $"{distance * 100f:F2} cm";
        }
        
        Toggle shareToggle = parent.Q<Toggle>(shareSegmentToggleName);
        if (shareToggle != null && shareToggle.value)
        {
            ruler.SyncSharedSegment(startPoint, endPoint, isDirectConnection, true);
        }
        
    }

    private void OnHighlightButtonClicked(VisualElement segmentContainer)
    {
        DropdownField startDropdown = segmentContainer.Q<DropdownField>(segmentStartDropdown);
        DropdownField endDropdown = segmentContainer.Q<DropdownField>(segmentEndDropdown);
        Toggle directToggle = segmentContainer.Q<Toggle>(directConnectionToggleName);
        
        // ¡NUEVO! Comprobamos si el share toggle de esta fila está marcado
        Toggle shareToggle = segmentContainer.Q<Toggle>(shareSegmentToggleName);
        
        if (startDropdown == null || endDropdown == null || startDropdown.index == -1 || endDropdown.index == -1) return;

        string startText = startDropdown.choices[startDropdown.index];
        string endText = endDropdown.choices[endDropdown.index];
        
        if (!int.TryParse(startText, out int startPointIndex) || !int.TryParse(endText, out int endPointIndex)) return;

        bool isDirectConnection = directToggle != null ? directToggle.value : false;
        bool isShared = shareToggle != null ? shareToggle.value : false;

        // Decidimos enviar por red o hacer solo local
        if (isShared)
        {
            ruler.HighlightSegmentNetworked(startPointIndex, endPointIndex, isDirectConnection);
        }
        else
        {
            ruler.HighlightSegmentLocalOnly(startPointIndex, endPointIndex, isDirectConnection);
        }
    }

    private void OnDeleteSegmentButtonClicked(VisualElement segmentContainer)
    {
        if (segmentContainer == null) return;
        var entryData = segmentContainer.userData as SegmentEntryData;
        
        if (entryData != null && entryData.currentSegment != default)
        {
            // Mandamos la orden a la red. El evento de vuelta se encargará de borrar la UI
            ruler.DeleteSegmentNetworked(entryData.currentSegment.x, entryData.currentSegment.y);
        }
    }
    
    private void HandleSharedSegmentDeleted(int start, int end)
    {
        VisualElement segmentsContainer = uIDocument.rootVisualElement.Q<VisualElement>(segmentsContainerName);
        if (segmentsContainer == null) return;

        foreach (var entry in segmentsContainer.Children().ToList())
        {
            var data = entry.userData as SegmentEntryData;
            if (data != null && data.currentSegment.x == start && data.currentSegment.y == end)
            {
                // Limpiamos los eventos por seguridad
                if (data.startDropdown != null && data.startCallback != null) data.startDropdown.UnregisterValueChangedCallback(data.startCallback);
                if (data.endDropdown != null && data.endCallback != null) data.endDropdown.UnregisterValueChangedCallback(data.endCallback);
                if (data.highlightButton != null && data.highlightAction != null) data.highlightButton.clicked -= data.highlightAction;
                if (data.deleteButton != null && data.deleteAction != null) data.deleteButton.clicked -= data.deleteAction;
                
                // Destruimos la fila de la interfaz
                entry.RemoveFromHierarchy();
                break; // Ya lo hemos encontrado y borrado
            }
        }
    }

    private void OnDirectConnectionToggleChanged(Toggle directConnectionToggle)
    {
        VisualElement segmentContainer = (VisualElement)directConnectionToggle.userData;
        if (segmentContainer == null) return;

        DropdownField startDropdown = segmentContainer.Q<DropdownField>(segmentStartDropdown);
        DropdownField endDropdown = segmentContainer.Q<DropdownField>(segmentEndDropdown);

        if (startDropdown != null && endDropdown != null && startDropdown.index != -1 && endDropdown.index != -1)
        {
            OnSegmentPointChanged(startDropdown, endDropdown);
        }
    }

    private void OnShareSegmentToggleChanged(Toggle shareSegmentToggle)
    {
        // 1. Obtener el contenedor visual (la "fila") de este segmento en concreto
        VisualElement segmentContainer = (VisualElement)shareSegmentToggle.userData;
        if (segmentContainer == null) return;
        
        // 2. Lógica de exclusión: Si encendemos este, apagamos los demás toggles de la lista
        if (shareSegmentToggle.value)
        {
            VisualElement segmentsContainer = segmentContainer.parent; 
            if (segmentsContainer != null)
            {
                foreach (var entry in segmentsContainer.Children())
                {
                    // Ignoramos la fila que acabamos de pulsar
                    if (entry == segmentContainer) continue; 

                    Toggle otherToggle = entry.Q<Toggle>(shareSegmentToggleName);
                    if (otherToggle != null && otherToggle.value)
                    {
                        // IMPORTANTE: Usamos SetValueWithoutNotify para apagarlo sin volver a disparar este evento en bucle
                        otherToggle.SetValueWithoutNotify(false);
                    }
                }
            }
        }

        // 3. Buscar los menús desplegables para saber qué puntos queremos unir
        DropdownField startDropdown = segmentContainer.Q<DropdownField>(segmentStartDropdown);
        DropdownField endDropdown = segmentContainer.Q<DropdownField>(segmentEndDropdown);
        Toggle directToggle = segmentContainer.Q<Toggle>(directConnectionToggleName);

        // 4. Si los dropdowns tienen valores seleccionados, enviamos la orden
        if (startDropdown != null && endDropdown != null && startDropdown.index != -1 && endDropdown.index != -1)
        {
            if (int.TryParse(startDropdown.choices[startDropdown.index], out int startPoint) &&
                int.TryParse(endDropdown.choices[endDropdown.index], out int endPoint))
            {
                bool isDirect = directToggle != null ? directToggle.value : false;
                
                // Llamamos a la función de tu Ruler, que pasará los puntos al NetworkedLineRenderer
                ruler.SyncSharedSegment(startPoint, endPoint, isDirect, shareSegmentToggle.value);
            }
        }
    }

    void OnDestroy()
    {
        if (addSegmentButton != null)
            addSegmentButton.clicked -= OnAddSegmentButtonClicked;
        
        if (uIDocument != null && uIDocument.rootVisualElement != null)
        {
            var segmentsContainer = uIDocument.rootVisualElement.Q<VisualElement>(segmentsContainerName);
            if (segmentsContainer != null)
            {
                foreach (var entry in segmentsContainer.Children())
                {
                    var data = entry.userData as SegmentEntryData;
                    if (data != null)
                    {
                        if (data.startDropdown != null && data.startCallback != null)
                            data.startDropdown.UnregisterValueChangedCallback(data.startCallback);
                        if (data.endDropdown != null && data.endCallback != null)
                            data.endDropdown.UnregisterValueChangedCallback(data.endCallback);
                        if (data.highlightButton != null && data.highlightAction != null)
                            data.highlightButton.clicked -= data.highlightAction;
                        if (data.deleteButton != null && data.deleteAction != null)
                            data.deleteButton.clicked -= data.deleteAction;
                        if (data.directConnectionToggle != null && data.directConnectionCallback != null)
                            data.directConnectionToggle.UnregisterValueChangedCallback(data.directConnectionCallback);
                        if (data.shareSegmentToggle != null && data.shareSegmentCallback != null)
                            data.shareSegmentToggle.UnregisterValueChangedCallback(data.shareSegmentCallback);
                    }
                }
            }
        }
    }
}