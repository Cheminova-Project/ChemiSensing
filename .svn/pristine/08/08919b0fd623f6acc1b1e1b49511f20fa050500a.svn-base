<tr id="row_113_46_4_" class="even" style="display:none;"><td class="entry"><span style="width:32px;display:inline-block;">&#160;</span><span id="arr_113_46_4_" class="arrow" onclick="dynsection.toggleFolder('113_46_4_')"><span class="arrowhead closed"></span></span><span class="icona"><span class="icon">C</span></span><a class="el" href="class_ruler.html" target="_self">Ruler</a></td><td class="desc">Componente de herramienta que permite medir distancias en un objeto 3D </td></tr>
