<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/CheminovaUI/Resources/UI/USS/utils.uss?fileID=7433441132597879392&amp;guid=9bc8afcbc8187b149860a5a14fc82d8c&amp;type=3#utils" />
    <ui:VisualElement name="Doc" class="interactive-item" style="flex-grow: 1; height: 150px; flex-direction: row; align-content: stretch; background-color: rgb(242, 189, 102); margin-left: 0; margin-right: 0; margin-top: 10px; margin-bottom: 10px; max-height: 200px;">
        <ui:Image name="doc-image-container" style="flex-grow: 1; width: 15%; max-width: 15%; background-image: none; -unity-background-scale-mode: scale-and-crop; padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px; -unity-background-image-tint-color: rgb(255, 255, 255); background-color: rgba(0, 0, 0, 0);">
            <ui:VisualElement name="doc-image" style="flex-grow: 1; background-size: 90% 90%; background-image: resource(&apos;UI/Icons/documentation/audio&apos;); -unity-background-scale-mode: scale-to-fit;" />
        </ui:Image>
        <AutoSizeLabel name="doc-name" text="label" group="annexdata-names" style="width: 85%; -unity-text-align: middle-left;" />
    </ui:VisualElement>
</ui:UXML>
