        if (m_NetworkedPlayerCharacter.IsLocalPlayer)
        {
            //Cosas que hacer cuando es el jugador local
        }
        else
        {
            //Cosas que hacer cuando no es el jugador local
        }
        base.ManageCharacterObjects();
