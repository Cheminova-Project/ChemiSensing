using UnityEngine;
using UnityEngine.Events;
using UnityEngine.UIElements;

/// <summary>
/// Clase base para todos los componentes de herramientas.
/// Se activa/desactiva automáticamente con OnEnable/OnDisable del GameObject.
/// </summary>
public class ToolComponent : MonoBehaviour
{
    [Header("Tool Events")]
    [SerializeField] private UnityEvent onToolActivated;
    [SerializeField] private UnityEvent onToolDeactivated;

    /// <summary>
    /// Evento que se dispara cuando la herramienta se activa.
    /// </summary>
    public UnityEvent OnToolActivated => onToolActivated;
    /// <summary>
    /// Evento que se dispara cuando la herramienta se desactiva.
    /// </summary>
    public UnityEvent OnToolDeactivated => onToolDeactivated;

    /// <summary>
    /// Referencia al documento de UI asociado.
    /// </summary>
    protected UIDocument uIDocument;

    /// <summary>
    /// Se llama automáticamente cuando el GameObject se activa.
    /// </summary>
    protected virtual void OnEnable()
    {
        uIDocument = GetComponentInParent<UIDocument>();
        OnToolActivatedInternal();
        onToolActivated?.Invoke();
    }

    /// <summary>
    /// Se llama automáticamente cuando el GameObject se desactiva.
    /// </summary>
    protected virtual void OnDisable()
    {
        OnToolDeactivatedInternal();
        onToolDeactivated?.Invoke();
    }

    /// <summary>
    /// Método virtual que se llama cuando la herramienta se activa. Override en clases derivadas para lógica específica.
    /// </summary>
    protected virtual void OnToolActivatedInternal()
    {
        Debug.Log($"[{GetType().Name}] Tool Activated");
    }

    /// <summary>
    /// Método virtual que se llama cuando la herramienta se desactiva. Override en clases derivadas para lógica específica.
    /// </summary>
    protected virtual void OnToolDeactivatedInternal()
    {
        Debug.Log($"[{GetType().Name}] Tool Deactivated");
    }
}