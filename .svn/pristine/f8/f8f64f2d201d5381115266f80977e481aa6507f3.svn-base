using UnityEngine;
using UnityEngine.UIElements;

/// <summary>
/// ScriptableObject que define un contexto de UI para la gestión de documentos UI Toolkit.
/// </summary>
[CreateAssetMenu(fileName = "UIDocumentContext", menuName = "UI/UIDocumentContext", order = 0)]
public class UIDocumentContextSO : ScriptableObject
{
    /// <summary>
    /// Nombre identificador del contexto de UI.
    /// </summary>
    public string contextName;
    /// <summary>
    /// Asset de VisualTree asociado a este contexto.
    /// </summary>
    public VisualTreeAsset visualTreeAsset;
    /// <summary>
    /// GameObject contenedor de scripts asociados al contexto.
    /// </summary>
    public GameObject scriptsContainer;
}