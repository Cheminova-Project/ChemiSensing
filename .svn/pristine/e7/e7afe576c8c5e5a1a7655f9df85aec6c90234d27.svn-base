/* Estilo base del item */
.interactive-item {
    background-color: #f0f0f0;
    padding: 6px 10px;
    border-radius: 4px;
}

/* Cambio al pasar el cursor */
.interactive-item:hover {
    border-width: 1px;
    border-color: rgba(0,0,0,0.5);
    border-style: solid;
}

.transparent-button
{
    transition: scale 0.15s ease-in-out;
}

.transparent-button:hover {
    scale: 1.1;
    cursor: pointer;
}

.unity-list-view__item .interactive-item {
    color: black;
}

/* SLIDERS VERTICALES */
.unity-scroller--vertical {
    width: 40px;  /* De 24px a 50px */
    align-items: center;
}

.unity-scroller--vertical > .unity-scroller__low-button,
.unity-scroller--vertical > .unity-scroller__high-button,
.unity-scroller--vertical > .unity-scroller__slider,
.unity-base-slider__dragger
{
    width: 80%;
    -unity-background-scale-mode: scale-to-fit;
}

.unity-scroller .unity-base-slider__tracker:hover {
    background-color:  rgb(188, 188, 188)
}

.unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color:  rgb(255, 255, 255)
}