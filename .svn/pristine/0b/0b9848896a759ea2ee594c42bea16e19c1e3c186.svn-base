<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/CheminovaUI/Resources/UI/USS/utils.uss?fileID=7433441132597879392&amp;guid=9bc8afcbc8187b149860a5a14fc82d8c&amp;type=3#utils" />
    <ui:VisualElement name="AnnexData" class="interactive-item" style="flex-grow: 1; height: 150px; flex-direction: row; align-content: stretch; background-color: rgb(242, 189, 102); margin-left: 5px; margin-right: 5px; margin-top: 10px; margin-bottom: 10px; max-height: 200px; border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px;">
        <ui:VisualElement name="annexdata-image-container" style="flex-grow: 1; width: 15%; max-width: 15%; background-image: none; -unity-background-scale-mode: scale-and-crop; padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px;">
            <ui:VisualElement name="annexdata-image" style="flex-grow: 1; background-image: resource(&apos;UI/Icons/ch_elements/home/documentation-sidebar&apos;); background-size: 100% 100%; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; -unity-background-scale-mode: scale-to-fit; margin-left: 5%; margin-top: 5%; margin-bottom: 5%; margin-right: 5%;" />
        </ui:VisualElement>
        <ui:VisualElement name="Content" style="flex-grow: 1; align-self: stretch; align-content: stretch; width: 85%; max-width: none; min-width: auto; height: 100%; -unity-text-align: upper-left;">
            <ui:VisualElement name="TopSide" style="flex-grow: 1; height: 35%; max-height: none; margin-top: 10px; font-size: 20px; -unity-text-align: upper-left;">
                <AutoSizeLabel text="Sample name" name="annexdata-name" group="annexdata-names" min-font-size="12" style="width: 90%; height: 90%; -unity-font-style: bold; -unity-text-align: middle-left; white-space: normal; font-size: 50px; padding-left: 16px; overflow: hidden; text-overflow: ellipsis;" />
            </ui:VisualElement>
            <ui:VisualElement name="BottomSide" style="flex-grow: 1; height: 25%; max-height: none; padding-top: 5px; padding-bottom: 5px; margin-top: 0; white-space: normal; flex-direction: row;">
                <ui:VisualElement name="created-on-box" style="flex-grow: 1; width: 50%; max-width: none; flex-direction: row; justify-content: center; font-size: 35px;">
                    <ui:VisualElement name="icon" style="flex-grow: 1; width: 20%; background-image: resource(&apos;UI/Icons/ch_elements/update&apos;); -unity-background-scale-mode: scale-to-fit; -unity-text-align: middle-left; align-content: auto; align-self: auto; flex-direction: row; flex-wrap: wrap; height: auto; align-items: center;" />
                    <AutoSizeLabel name="annexdata-date" group="bottom-part" text="DATE OF CREATION" style="height: auto; width: 80%; -unity-text-align: middle-left; font-size: 30px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 5px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 5px; -unity-font-definition: url(&quot;project://database/Assets/CheminovaUI/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=4a1476c8669dd904ea21a335f921663c&amp;type=3#NotInter-Regular&quot;); -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement name="username-box" style="flex-grow: 1; width: 50%; max-width: none; flex-direction: row; justify-content: flex-end; font-size: 35px; align-items: stretch; align-self: auto; align-content: flex-start;">
                    <ui:VisualElement name="icon" style="flex-grow: 1; width: 20%; background-image: resource(&apos;UI/Icons/ch_elements/person&apos;); -unity-background-scale-mode: scale-to-fit; -unity-text-align: middle-left; align-content: auto; align-self: auto; flex-direction: row; flex-wrap: wrap;" />
                    <AutoSizeLabel name="annexdata-username" group="bottom-part" text="USER" style="height: auto; width: 80%; -unity-text-align: middle-left; font-size: 30px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 5px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 5px; -unity-font-definition: url(&quot;project://database/Assets/CheminovaUI/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=4a1476c8669dd904ea21a335f921663c&amp;type=3#NotInter-Regular&quot;); -unity-font-style: bold;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
