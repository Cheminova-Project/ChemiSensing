<p>Actualiza un reporte de condición en la API. </p>
<dl class="params"><dt>Parameters</dt><dd>
  <table class="params">
    <tr><td class="paramname">onCompleted</td><td>Acción a ejecutar al completar la actualización, con los datos del reporte de condición y el estado de éxito.</td></tr>
    <tr><td class="paramname">id</td><td>ID del reporte de condición a actualizar.</td></tr>
    <tr><td class="paramname">address</td><td>Dirección del reporte de condición.</td></tr>
    <tr><td class="paramname">author</td><td>Autor del reporte de condición.</td></tr>
    <tr><td class="paramname">chInspectionModes</td><td>Modos de inspección.</td></tr>
    <tr><td class="paramname">chUsages</td><td>Descripciones de uso.</td></tr>
    <tr><td class="paramname">colocationCharacteristics</td><td>Características de colocación.</td></tr>
    <tr><td class="paramname">conservationHistory</td><td>Historial de conservación.</td></tr>
    <tr><td class="paramname">culturalSphere</td><td>Esfera cultural.</td></tr>
    <tr><td class="paramname">date</td><td>Fecha del reporte de condición.</td></tr>
    <tr><td class="paramname">description</td><td>Descripción del reporte de condición.</td></tr>
    <tr><td class="paramname">diagnosisDescription</td><td>Descripción del diagnóstico.</td></tr>
    <tr><td class="paramname">environmentalConditionsCurrentWeatherCondition</td><td>Condiciones ambientales - Clima actual.</td></tr>
    <tr><td class="paramname">environmentalConditionsPastWeekWeatherCondition</td><td>Condiciones ambientales - Clima de la última semana.</td></tr>
    <tr><td class="paramname">environmentalConditionsRelativeHumidity</td><td>Humedad relativa.</td></tr>
    <tr><td class="paramname">environmentalConditionsTemperature</td><td>Temperatura.</td></tr>
    <tr><td class="paramname">idAnnotations</td><td>IDs de las anotaciones.</td></tr>
    <tr><td class="paramname">legalStatus</td><td>Estado legal.</td></tr>
    <tr><td class="paramname">municipality</td><td>Municipio.</td></tr>
    <tr><td class="paramname">name</td><td>Nombre del reporte de condición.</td></tr>
    <tr><td class="paramname">objectString</td><td>Cadena del objeto.</td></tr>
    <tr><td class="paramname">parentAssetName</td><td>Nombre del activo padre.</td></tr>
    <tr><td class="paramname">province</td><td>Provincia.</td></tr>
    <tr><td class="paramname">referenceCartographyCadastralParcel</td><td>Referencia cartográfica - Parcela catastral.</td></tr>
    <tr><td class="paramname">referenceCartographyCadastralSheet</td><td>Referencia cartográfica - Hoja catastral.</td></tr>
    <tr><td class="paramname">referenceCartographyMunicipality</td><td>Referencia cartográfica - Municipio.</td></tr>
    <tr><td class="paramname">referenceCartographyOther</td><td>Referencia cartográfica - Otro.</td></tr>
    <tr><td class="paramname">reportReferences</td><td>Referencias del reporte.</td></tr>
    <tr><td class="paramname">specificLocation</td><td>Ubicación específica.</td></tr>
    <tr><td class="paramname">stateOfConservation</td><td>Estado de conservación.</td></tr>
    <tr><td class="paramname">status</td><td>Estado.</td></tr>
    <tr><td class="paramname">subject</td><td>Asunto del reporte de condición.</td></tr>
    <tr><td class="paramname">surveyDate</td><td>Fecha de la encuesta.</td></tr>
    <tr><td class="paramname">surveyResponsible</td><td>Responsable de la encuesta.</td></tr>
    <tr><td class="paramname">techniques</td><td>Técnicas utilizadas.</td></tr>
  </table>
  </dd>
</dl>

